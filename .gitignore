# Secrets (tokens live outside the repo; these are a safety net)
.env
*.env
secrets/
*.token
*.key
*.pem

# Data spool and logs
spool/
*.ndjson
*.ndjson.gz
logs/
*.log
# ...but motion recordings for tuning the wearables are kept
!Firmware/recordings/*.log

# Python
venv/
.venv/
__pycache__/
*.pyc

# TouchDesigner autosaves, backups and crash files
Backup/
*.toe.bak
CrashAutoSave*
*.dmp

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/

# Embody / Envoy (auto-managed)
TouchDesigner/TDPyEnvManagerContext.yaml
.mcp.json
.embody_backup/
.tdn_backup/
opencode.json
.cursor/mcp.json
.vscode/mcp.json
.gemini/settings.json
.codex/config.toml
.agents/mcp_config.json
**/.embody/*
!**/.embody/project.json
.claude/settings.local.json
.claude/projects/
briefs/

# TouchDesigner cache
TouchDesigner/TDImportCache/

# MediaPipe plugin toxes (500 MB+, too big for GitHub; each machine downloads
# release.zip from github.com/torinmb/mediapipe-touchdesigner, see README)
TouchDesigner/toxes/

# TouchDesigner numbered saves (Embody keeps DanceWorkshop.toe as the current copy)
TouchDesigner/*.[0-9]*.toe

# Local notes from another project; not published
HANDOFF_TouchDesigner_lessons.md
