    inputs:
    - render
  - name: start_particles
    type: executeDAT
    parameters:
      fromop: =parent()
      start: true
      file: project1/visuals/particles/start_particles.py
      syncfile: true
    position: [0, -800]
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
  annotations:
  - name: annotate1
    mode: annotate
    title: Particles
    text: 'live: this instrument''s values from the engine (particles_*). geo: emit_points -> particle_sim -> force_curl (2D curl noise sets the velocity: Energy = speed, Turbulence = swirl size) -> force_center (pull, Spread) -> flatten -> null_loop (fed back to particle_sim). Rendered as soft point sprites (Size), then trails (feedback, Trails), level_gain, palette lookup (Colour, palette_* tables), glow -> out1. presets: Calm / Flowing / Energetic values (applied by visuals/instrument_presets). start_particles initializes and starts the simulation on project open.'
    position: [-70, -1070]
    size: [5070, 1730]
    color: [0.45, 0.45, 0.45]
- name: comp_layers
  type: compositeTOP
  parameters:
    operand: over
    outputresolution: custom
    resolutionw: =parent.Visuals.par.Resolution1
    resolutionh: =parent.Visuals.par.Resolution2
  flags:
  - viewer
  position: [400, 0]
  inputs:
  - layer4
  - layer3
  - layer2
  - layer1
  - bg_black
- name: cross_flash
  type: crossTOP
  parameters:
    cross: =tdu.clamp(op('master_live')['flash'], 0, 1)
  flags:
  - viewer
  position: [650, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - comp_layers
  - flash_white
- name: flash_white
  type: constantTOP
  flags:
  - viewer
  position: [400, -300]
- name: master_live
  type: nullCHOP
  position: [425, 575]
  inputs:
  - master_select
- name: level_master
  type: levelTOP
  parameters:
    brightness1: =tdu.clamp(op('master_live')['level'], 0, 1) * (1 - tdu.clamp(op('master_live')['blackout'], 0, 1))
  flags:
  - viewer
  position: [850, 0]
  inputs:
  - cross_flash
- name: master_select
  type: selectCHOP
  parameters:
    channames: master_*
    renamefrom: master_*
  position: [25, 575]
- name: output_window
  type: windowCOMP
  parameters:
    winop: null_out
    title: =me
  flags:
  - viewer
  position: [1025, -175]
  size: [160, 130]
  color: [0.67, 0.67, 0.67]
- name: output_buttons
  type: parameterexecuteDAT
  parameters:
    op: ..
    pars: '*'
    valuechange: false
    file: project1/visuals/output_buttons.py
  flags:
  - viewer
  position: [1250, -175]
- name: instrument_presets
  type: parameterexecuteDAT
  parameters:
    op: '*'
    pars: Preset Reset
    file: project1/visuals/instrument_presets.py
  position: [400, -1200]
annotations:
- name: annotate1
  mode: annotate
  title: Visuals
  text: 'Four layers (clones of layer1, so they share its network; each has its own settings) are composited over black with layer 4 on top. Then master Flash (cross to white) and Level / Blackout. null_out is the final image; output_window shows it full screen (Window COMP: Open as Separate Window).'
  position: [-70, -371]
  size: [1731, 1126]
  color: [0.45, 0.45, 0.45]
- name: annotate2
  mode: annotate
  title: Instruments
  text: 'Visual instruments: any COMP here with an Instrument page (see README). Its settings become engine targets (particles.energy ...) and its out1 is its image. instrument_presets applies each instrument''s presets table when Preset changes or Reset is pressed.'
  position: [-70, -1270]
  size: [670, 370]
  color: [0.45, 0.45, 0.45]
