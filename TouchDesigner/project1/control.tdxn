  Inputs:
  - name: Hinpuwebcam
    style: Header
    label: Webcam
  - name: Inpuinputswebcamuse
    style: Menu
    label: Use
    default: 'off'
    menuSource: me.parent().op('inputs').par.Webcamuse
    help: 'What the webcam is for. Off: nothing opens it, camera and pose signals are 0. Movement Only: camera motion signals (light, no MediaPipe). Body Tracking: MediaPipe tracks the dancer (pose signals, body mask) and the camera motion signals work too. Test: a moving test pattern and a made-up dancer, no webcam needed. Read Status below to see if it works.'
    value: ~me.parent().op('inputs').par.Webcamuse
  - name: Inpuinputscameradevice
    style: StrMenu
    label: Webcam
    menuSource: me.parent().op('inputs').par.Cameradevice
    help: The one webcam the project uses, for camera motion, body tracking and the Video Feedback instrument. Close other apps that use it.
    value: ~me.parent().op('inputs').par.Cameradevice
  - name: Inpuinputswebcamstatus
    style: Str
    label: Status
    readOnly: true
    help: 'Read only: what the webcam is doing right now, and what to do if it is not working. The same line shows on pose_monitor.'
    value: ~me.parent().op('inputs').par.Webcamstatus
  - name: Hinpuwearables
    style: Header
    label: Wearables
  - name: Inpuinputsserialenable
    style: Toggle
    label: Read Serial
    help: 'Read lines of text from a serial (USB) device such as the wireless receiver. Off when the project opens: turn it on once the receiver is plugged in and its Port is picked. Missing and Bluetooth ports are never opened (see Status).'
    value: ~me.parent().op('inputs').par.Serialenable
  - name: Inpuinputsserialport
    style: StrMenu
    label: Port
    menuSource: me.parent().op('inputs').par.Serialport
    help: Serial port of the device (COM3 on Windows, /dev/cu.usbmodem... on macOS). The menu lists the ports TouchDesigner can see.
    value: ~me.parent().op('inputs').par.Serialport
  - name: Inpuinputsserialstatus
    style: Str
    label: Status
    readOnly: true
    help: 'What Read Serial is doing now. A missing port or a Bluetooth port is never opened (either froze TouchDesigner), so a wrong Port is safe: pick the receiver and reading starts within a second.'
    value: ~me.parent().op('inputs').par.Serialstatus
  - name: Inpuinputswearable1
    style: Toggle
    label: Use Wearable 1
    default: true
    help: 'On: wearable 1''s signals (serial_w1_...) reach the mappings and wearable_monitor. Off: they are dropped, as if that wearable were switched off. Each group turns on only its own wearable.'
    value: ~me.parent().op('inputs').par.Wearable1
  - name: Inpuinputswearable2
    style: Toggle
    label: Use Wearable 2
    default: true
    help: 'On: wearable 2''s signals (serial_w2_...) reach the mappings and wearable_monitor. Off: they are dropped, as if that wearable were switched off. Each group turns on only its own wearable.'
    value: ~me.parent().op('inputs').par.Wearable2
  - name: Inpuinputswearable3
    style: Toggle
    label: Use Wearable 3
    default: true
    help: 'On: wearable 3''s signals (serial_w3_...) reach the mappings and wearable_monitor. Off: they are dropped, as if that wearable were switched off. Each group turns on only its own wearable.'
    value: ~me.parent().op('inputs').par.Wearable3
  - name: Hinpubody
    style: Header
    label: Body Tracking
  - name: Inpuinputsposezones
    style: Int
    label: Stage Zones
    default: 3
    min: 1.0
    max: 5.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 5.0
    help: How many equal zones pose_x is split into, left to right (1-5). pose_zone says which one the dancer is in (1 = left), and pose_zone1 ... pose_zone5 are 1 in that zone. Shown on pose_monitor.
    value: ~me.parent().op('inputs').par.Posezones
parameters:
  parentshortcut: Control
  opshortcut: Control
sequences:
  ext:
  - object: op('./ControlExt').module.ControlExt(me)
    name: Control
    promote: true
color: [0.3, 0.5, 0.9]
tags:
- tdxn
storage:
  _pageNames:
    show: Show
    instruments: Instruments
    composition: Composition
    movement: Movement
    inputs: Inputs
operators:
- name: layout
  type: tableDAT
  parameters:
    file: project1/control/layout.tsv
    syncfile: true
    rows: 145
    cols: 5
  position: [0, -200]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - tsv
- name: ControlExt
  type: textDAT
  parameters:
    file: project1/control/ControlExt.py
    syncfile: true
    language: python
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: control_pulses
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: Mode Showtransportreset Showvisualsopenwindow Showvisualsclosewindow Instparticlesreset Instvideoreset Instnoisereset
    builtin: false
    file: project1/control/control_pulses.py
    syncfile: true
  position: [0, -400]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
annotations:
- name: annotate1
  mode: annotate
  title: Control panel
  text: layout lists every control (tab, section, component, parameter, Basic, instrument). Edit it, then op.Control.Rebuild(). ControlExt binds each control to its parameter; control_pulses rebuilds on Mode / Instrument and forwards pulses.
  position: [-70, -470]
  size: [270, 730]
  color: [0.45, 0.45, 0.45]
