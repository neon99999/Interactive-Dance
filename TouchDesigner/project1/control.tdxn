format: tdxn
version: '2.2'
build: 1
generator: Embody/6.2.76
td_build: 099.2025.32280
network_path: /project1/control
options:
  include_dat_content: false
  include_storage: true
type: baseCOMP
custom_pars:
  Show:
  - name: Mode
    style: Menu
    label: Level
    default: level1
    menuNames:
    - level1
    - level2
    - level3
    - advanced
    menuLabels:
    - Level 1
    - Level 2
    - Level 3
    - Advanced
    help: 'Level 1: music, phases and trigger events. Level 2: adds continuous links. Level 3: everything for students. Advanced: every setting.'
  - name: Hshowshow
    style: Header
    label: Language and Level
  - name: Showlanglanguage
    style: Menu
    label: Language / Idioma
    default: en
    menuNames:
    - en
    - es
    menuLabels:
    - English
    - Español
    help: Language of the controls and panels dancers use. / Idioma de los controles y paneles que usan los bailarines.
    value: ~me.parent().op('lang').par.Language
  - name: Hshowmusic
    style: Header
    label: Music
  - name: Showtransportplay
    style: Toggle
    label: Play
    help: On plays audio and MIDI together from the current position; off pauses both.
    value: ~me.parent().op('transport').par.Play
  - name: Showtransportreset
    style: Pulse
    label: Reset
    help: Return audio and MIDI to 0 seconds. Does not fire any notes.
  - name: Showtransportposition
    style: Float
    label: Position (s)
    readOnly: true
    help: Current shared playback position in seconds (read-only).
    value: ~me.parent().op('transport').par.Position
  - name: Showtransportaudiofile
    style: File
    label: Audio File
    help: Music file (WAV or MP3) played in sync with the MIDI file.
    value: ~me.parent().op('transport').par.Audiofile
  - name: Showtransportmidifile
    style: File
    label: MIDI File
    help: Standard MIDI File (.mid) whose Note On events are read on the same clock as the audio.
    value: ~me.parent().op('transport').par.Midifile
  - name: Hshowoutput
    style: Header
    label: Output
  - name: Showvisualsopenwindow
    style: Pulse
    label: Open Output Window
    help: Open the output window (the final image) for the projector or second screen. Set the monitor on output_window if needed.
  - name: Showvisualsclosewindow
    style: Pulse
    label: Close Output Window
    help: Close the output window.
  - name: Showvisualslevel
    style: Float
    label: Level
    default: 1
    clampMin: true
    clampMax: true
    help: 'Overall brightness of the output: 1 = normal, 0 = black. MIDI target master.level (use fade for fade-outs).'
    value: ~me.parent().op('visuals').par.Level
  - name: Showvisualsblackout
    style: Toggle
    label: Blackout
    help: On = output is black. MIDI target master.blackout.
    value: ~me.parent().op('visuals').par.Blackout
  Phases:
  - name: Hphasphases
    style: Header
    label: Phases (song)
  - name: Phaseventsvisible
    style: Toggle
    label: 'On'
    default: true
    help: Show the Phase Events (the placeholder shapes of the current phase) in the output.
    value: ~me.parent().op('visuals/events').par.Visible
  - name: Phasphasesphase
    style: Menu
    label: Phase
    default: '1'
    menuNames:
    - '1'
    - '2'
    - '3'
    - '4'
    - '5'
    - '6'
    - '7'
    - '8'
    menuLabels:
    - Phase 1
    - Phase 2
    - Phase 3
    - Phase 4
    - Phase 5
    - Phase 6
    - Phase 7
    - Phase 8
    help: The phase shown below. Follow MIDI switches it when the song plays a phase note. Edits are saved into this phase at once.
    value: ~me.parent().op('phases').par.Phase
  - name: Phasphasesphasenote
    style: Int
    label: Note for This Phase
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: The MIDI note of the song that starts the shown phase (-1 = none).
    value: ~me.parent().op('phases').par.Phasenote
  - name: Phasphasesfollowmidi
    style: Toggle
    label: Follow MIDI
    default: true
    help: 'On: a phase note of the song switches the phase (before the first one: phase 1). Off: only the Phase menu switches it.'
    value: ~me.parent().op('phases').par.Followmidi
  - name: Hphasphasecopy
    style: Header
    label: Clear
  - name: Phasphasesclear
    style: Pulse
    label: Clear Phase
    help: Empty every event of the shown phase.
  - name: Hphasshowfile
    style: Header
    label: Save and load the show
  - name: Phasphasesshowfile
    style: File
    label: Show File
    default: shows/my_show.json
    help: 'The show file: a name (shows/my_show.json, next to the project) or any file. Save Show writes it, Load Show reads it.'
    value: ~me.parent().op('phases').par.Showfile
  - name: Phasphasessaveshow
    style: Pulse
    label: Save Show
    help: Write the phases, the music, the mapping presets and the instrument settings to the Show File.
  - name: Phasphasesloadshow
    style: Pulse
    label: Load Show
    help: Read the Show File and set everything in it.
  - name: Phasphasesshowstatus
    style: Str
    label: Show Status
    readOnly: true
    help: What the last Save Show or Load Show did.
    value: ~me.parent().op('phases').par.Showstatus
  - name: Hphasevent1
    style: Header
    label: Event 1
  - name: Phasphasesev1on
    style: Toggle
    label: 1 On
    help: Use this event in the phase.
    value: ~me.parent().op('phases').par.Ev1on
  - name: Phasphasesev1name
    style: Str
    label: 1 Name
    help: 'The name written in the shape: what the action is, e.g. punch explode.'
    value: ~me.parent().op('phases').par.Ev1name
  - name: Phasphasesev1shape
    style: Menu
    label: 1 Shape
    default: rectangle
    menuNames:
    - rectangle
    - circle
    - triangle
    menuLabels:
    - Rectangle
    - Circle
    - Triangle
    help: The placeholder shape.
    value: ~me.parent().op('phases').par.Ev1shape
  - name: Phasphasesev1colour
    style: Menu
    label: 1 Colour
    default: white
    menuNames:
    - white
    - red
    - orange
    - yellow
    - green
    - cyan
    - blue
    - magenta
    menuLabels:
    - White
    - Red
    - Orange
    - Yellow
    - Green
    - Cyan
    - Blue
    - Magenta
    help: The colour of the shape.
    value: ~me.parent().op('phases').par.Ev1colour
  - name: Phasphasesev1x
    style: Float
    label: 1 X
    normMin: -1.0
    help: Position left (-1) to right (1).
    value: ~me.parent().op('phases').par.Ev1x
  - name: Phasphasesev1y
    style: Float
    label: 1 Y
    normMin: -1.0
    help: Position bottom (-1) to top (1).
    value: ~me.parent().op('phases').par.Ev1y
  - name: Phasphasesev1size
    style: Float
    label: 1 Size
    default: 0.3
    clampMin: true
    normMin: 0.05
    help: Size, as a part of the screen height.
    value: ~me.parent().op('phases').par.Ev1size
  - name: Phasphasesev1show
    style: Menu
    label: 1 Show
    default: timed
    menuNames:
    - always
    - toggle
    - timed
    menuLabels:
    - Always
    - Toggle
    - For a time
    help: 'Always: on for the whole phase. Toggle: the trigger shows it, the trigger again hides it. For a time: the trigger shows it for Time seconds.'
    value: ~me.parent().op('phases').par.Ev1show
  - name: Phasphasesev1time
    style: Float
    label: 1 Time
    default: 1
    clampMin: true
    normMax: 10.0
    help: 'For a time: how many seconds the event stays. A new trigger starts the time again.'
    enable: false
    value: ~me.parent().op('phases').par.Ev1time
  - name: Phasphasesev1trigger
    style: Menu
    label: 1 Trigger
    default: none
    menuNames:
    - none
    - midi
    - serial_w1_hit
    - serial_w1_btn
    - serial_w2_hit
    - serial_w2_btn
    - serial_w3_hit
    - serial_w3_btn
    menuLabels:
    - Nothing
    - MIDI note (song)
    - 'Wearable 1: hit'
    - 'Wearable 1: button'
    - 'Wearable 2: hit'
    - 'Wearable 2: button'
    - 'Wearable 3: hit'
    - 'Wearable 3: button'
    help: 'What shows the event: a MIDI note of the song, or a wearable hit or button.'
    value: ~me.parent().op('phases').par.Ev1trigger
  - name: Phasphasesev1note
    style: Int
    label: 1 Note
    default: 60
    max: 127.0
    clampMin: true
    clampMax: true
    normMax: 127.0
    help: The MIDI note of the song, for a MIDI trigger.
    enable: false
    value: ~me.parent().op('phases').par.Ev1note
  - name: Hphasevent2
    style: Header
    label: Event 2
  - name: Phasphasesev2on
