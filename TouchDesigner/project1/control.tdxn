  - name: Movemappingsmap6on
    style: Toggle
    label: 6 On
    help: Mapping 6 is used while on.
    value: ~me.parent().op('mappings').par.Map6on
  - name: Movemappingsmap6signal
    style: StrMenu
    label: 6 Movement
    menuSource: me.parent().op('mappings').par.Map6signal
    help: The movement signal that drives this mapping. Pick from the menu or type a signal name.
    value: ~me.parent().op('mappings').par.Map6signal
  - name: Movemappingsmap6target
    style: StrMenu
    label: 6 Visual
    menuSource: me.parent().op('mappings').par.Map6target
    help: The visual value it changes. Choosing one sets From and To to its usual range.
    value: ~me.parent().op('mappings').par.Map6target
  - name: Movemappingsmap7on
