  - name: Comptriggeropacity
    style: Float
    label: Opacity
    default: 1
    clampMin: true
    clampMax: true
    help: 'How strongly this instrument shows in the output: 0 = invisible, 1 = full.'
    value: ~me.parent().op('visuals/trigger').par.Opacity
  Movement:
  - name: Hmoveconnection1
    style: Header
    label: Connection 1
  - name: Movemappingscon1on
    style: Toggle
    label: 1 On
    help: Connection 1 is used while on.
    value: ~me.parent().op('mappings').par.Con1on
  - name: Movemappingscon1source
    style: Menu
    label: 1 Source
    default: none
    menuSource: me.parent().op('mappings').par.Con1source
    help: 'Where the movement comes from: a wearable, the body (camera), the song ...'
    value: ~me.parent().op('mappings').par.Con1source
  - name: Movemappingscon1input
    style: Menu
    label: 1 Input
    default: none
    menuSource: me.parent().op('mappings').par.Con1input
    help: The movement or the moment. A movement (tilt, position ...) controls a setting all the time. A moment (a hit, a note, enters a zone ...) does something once.
    value: ~me.parent().op('mappings').par.Con1input
  - name: Movemappingscon1instrument
    style: Menu
    label: 1 Instrument
    default: none
    menuSource: me.parent().op('mappings').par.Con1instrument
    help: 'The instrument it acts on. Whole picture: brightness, saturation and the effects.'
    value: ~me.parent().op('mappings').par.Con1instrument
  - name: Movemappingscon1does
    style: Menu
    label: 1 Does
    default: none
    menuSource: me.parent().op('mappings').par.Con1does
    help: 'What happens. Controls: the movement sets the value. Burst: the value jumps and falls back. Other actions happen once.'
    value: ~me.parent().op('mappings').par.Con1does
  - name: Movemappingscon1note
    style: Int
    label: 1 Note
    default: 60
    max: 127.0
    clampMin: true
    clampMax: true
    normMax: 127.0
    help: The MIDI note number (0-127) when Input is a note of the song. midi_monitor shows the numbers as the song plays.
    enable: false
    value: ~me.parent().op('mappings').par.Con1note
  - name: Movemappingscon1amount
    style: Float
    label: 1 Amount
    default: 0.5
    normMax: 2.0
    help: 'How much, for a moment: how far a burst jumps, how far the shape jumps or spins.'
    enable: false
    value: ~me.parent().op('mappings').par.Con1amount
  - name: Movemappingsmap1from
    style: Float
    label: 1 From
    normMin: -1.0
    help: Visual value when the movement is at its lowest.
    value: ~me.parent().op('mappings').par.Map1from
  - name: Movemappingsmap1to
    style: Float
    label: 1 To
    default: 1
    normMin: -1.0
    help: Visual value when the movement is at its highest.
    value: ~me.parent().op('mappings').par.Map1to
  - name: Movemappingsmap1smooth
    style: Float
    label: 1 Smoothing
    default: 0.1
    clampMin: true
    normMax: 2.0
    help: 'Seconds the visual takes to follow the movement. 0: instant.'
    value: ~me.parent().op('mappings').par.Map1smooth
  - name: Movemappingsmap1sens
    style: Float
    label: 1 Sensitivity
    default: 1
    min: 0.1
    clampMin: true
    normMin: 0.5
    normMax: 5.0
    help: 'How much movement reaches To: 1 = the full movement, 2 = half of it.'
    value: ~me.parent().op('mappings').par.Map1sens
