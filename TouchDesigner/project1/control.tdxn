  Movement:
  - name: Hmovemovement
    style: Header
    label: Mapping Preset
  - name: Movemappingspreset
    style: Menu
    label: Preset
    default: A
    menuNames:
    - A
    - B
    - C
    - D
    menuLabels:
    - Preset A
    - Preset B
    - Preset C
    - Preset D
    help: Which set of 8 mappings is active. Edits are saved into the chosen preset at once.
    value: ~me.parent().op('mappings').par.Preset
  - name: Movemappingspresetnotea
    style: Int
    label: Note for Preset A
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: 'The MIDI note in the song that switches to preset A (needs Follow MIDI on). -1: none.'
    value: ~me.parent().op('mappings').par.Presetnotea
  - name: Movemappingspresetnoteb
    style: Int
    label: Note for Preset B
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: 'The MIDI note in the song that switches to preset B (needs Follow MIDI on). -1: none.'
    value: ~me.parent().op('mappings').par.Presetnoteb
  - name: Movemappingspresetnotec
    style: Int
    label: Note for Preset C
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: 'The MIDI note in the song that switches to preset C (needs Follow MIDI on). -1: none.'
    value: ~me.parent().op('mappings').par.Presetnotec
  - name: Movemappingspresetnoted
    style: Int
    label: Note for Preset D
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: 'The MIDI note in the song that switches to preset D (needs Follow MIDI on). -1: none.'
    value: ~me.parent().op('mappings').par.Presetnoted
  - name: Hmovetriggers
    style: Header
    label: Triggers (Trigger Shape)
  - name: Movetriggervisible
    style: Toggle
    label: 'On'
    help: 'Show the Trigger Shape in the output. MIDI: show / hide / toggle trigger.'
    value: ~me.parent().op('visuals/trigger').par.Visible
  - name: Movemappingstrig1on
    style: Toggle
    label: 1 On
    help: Trigger 1 is used while on.
    value: ~me.parent().op('mappings').par.Trig1on
  - name: Movemappingstrig1when
    style: Menu
    label: 1 When
    default: midi
    menuNames:
    - midi
    - serial_w1_hit
    - serial_w1_btn
    - serial_w2_hit
    - serial_w2_btn
    - serial_w3_hit
    - serial_w3_btn
    menuLabels:
    - MIDI note
    - 'Wearable 1: hit'
    - 'Wearable 1: button'
    - 'Wearable 2: hit'
    - 'Wearable 2: button'
    - 'Wearable 3: hit'
    - 'Wearable 3: button'
    help: 'What sets it off: a MIDI note of the song, or a wearable hit or button.'
    value: ~me.parent().op('mappings').par.Trig1when
  - name: Movemappingstrig1note
    style: Int
    label: 1 Note
    default: 60
    max: 127.0
    clampMin: true
    clampMax: true
    normMax: 127.0
    help: The MIDI note number (0-127) when When is MIDI note. midi_monitor shows the numbers as the song plays.
    value: ~me.parent().op('mappings').par.Trig1note
  - name: Movemappingstrig1does
    style: Menu
    label: 1 Does
    default: pulse
    menuNames:
    - pulse
    - spin
    - sides
    - jump
    - flash
    menuLabels:
    - Pulse (grow)
    - Spin
    - More sides
    - Jump
    - Flash colour
    help: What the Trigger Shape does each time.
    value: ~me.parent().op('mappings').par.Trig1does
  - name: Movemappingstrig1amount
    style: Float
    label: 1 Amount
    default: 0.5
    min: -180.0
    max: 180.0
    normMax: 2.0
    help: 'How much: Pulse = how much bigger (0.5 = half again), Spin = degrees, More sides = sides added, Jump = how far, Flash = how strong (0-1).'
    value: ~me.parent().op('mappings').par.Trig1amount
