format: tdxn
version: '2.2'
build: 1
generator: Embody/6.2.76
td_build: 099.2025.32280
network_path: /project1/control
options:
  include_dat_content: false
  include_storage: true
type: baseCOMP
custom_pars:
  Show:
  - name: Mode
    style: Menu
    default: basic
    menuNames:
    - basic
    - advanced
    menuLabels:
    - Basic
    - Advanced
    help: Basic shows the few controls needed on day one. Advanced shows every setting.
  - name: Hshowshow
    style: Header
    label: Language and Mode
  - name: Showlanglanguage
    style: Menu
    label: Language / Idioma
    default: en
    menuSource: me.parent().op('lang').par.Language
    help: Language of the controls and panels dancers use. / Idioma de los controles y paneles que usan los bailarines.
    value: ~me.parent().op('lang').par.Language
  - name: Hshowmusic
    style: Header
    label: Music
  - name: Showtransportplay
    style: Toggle
    label: Play
    help: On plays audio and MIDI together from the current position; off pauses both.
    value: ~me.parent().op('transport').par.Play
  - name: Showtransportreset
    style: Pulse
    label: Reset
    help: Return audio and MIDI to 0 seconds. Does not fire any notes.
  - name: Showtransportposition
    style: Float
    label: Position (s)
    readOnly: true
    help: Current shared playback position in seconds (read-only).
    value: ~me.parent().op('transport').par.Position
  - name: Showtransportaudiofile
    style: File
    label: Audio File
    help: Music file (WAV or MP3) played in sync with the MIDI file.
    value: ~me.parent().op('transport').par.Audiofile
  - name: Showtransportmidifile
    style: File
    label: MIDI File
    help: Standard MIDI File (.mid) whose Note On events are read on the same clock as the audio.
    value: ~me.parent().op('transport').par.Midifile
  - name: Hshowoutput
    style: Header
    label: Output
  - name: Showvisualsopenwindow
    style: Pulse
    label: Open Output Window
    help: Open the output window (the final image) for the projector or second screen. Set the monitor on output_window if needed.
  - name: Showvisualsclosewindow
    style: Pulse
    label: Close Output Window
    help: Close the output window.
  - name: Showvisualslevel
    style: Float
    label: Level
    default: 1
    clampMin: true
    clampMax: true
    help: 'Overall brightness of the output: 1 = normal, 0 = black. MIDI target master.level (use fade for fade-outs).'
    value: ~me.parent().op('visuals').par.Level
  - name: Showvisualsblackout
    style: Toggle
    label: Blackout
    help: On = output is black. MIDI target master.blackout.
    value: ~me.parent().op('visuals').par.Blackout
  Instruments:
  - name: Hinstparticles
    style: Header
    label: Particles
  - name: Instparticlesvisible
    style: Toggle
    label: 'On'
    default: true
    help: 'Show the particles. MIDI: show / hide / toggle particles.'
    value: ~me.parent().op('visuals/particles').par.Visible
  - name: Instparticlespreset
    style: Menu
    label: Preset
    default: flowing
    menuSource: me.parent().op('visuals/particles').par.Preset
    help: 'A starting look: Calm (slow, wide, long trails), Flowing (the default), Energetic (fast, wild, short trails). Choosing one sets the six settings below.'
    value: ~me.parent().op('visuals/particles').par.Preset
  - name: Instparticlesreset
    style: Pulse
    label: Reset to Preset
    help: Put the six settings back to the chosen preset.
  - name: Instparticlesenergy
    style: Float
    label: Energy
    default: 0.4
    clampMin: true
    clampMax: true
    help: 'How strongly and fast the particles move: 0 = almost still, 1 = wild bursts. Good for activity, energy or hits.'
    value: ~me.parent().op('visuals/particles').par.Energy
  - name: Instparticlesspread
    style: Float
    label: Spread
    default: 0.5
    clampMin: true
    clampMax: true
    help: 'How far the particles spread: 0 = a tight cloud in the centre, 1 = the whole screen.'
    value: ~me.parent().op('visuals/particles').par.Spread
  - name: Instparticlesturbulence
    style: Float
    label: Turbulence
    default: 0.45
    clampMin: true
    clampMax: true
    help: 'How irregular the motion is: 0 = big smooth swirls, 1 = small, restless eddies.'
    value: ~me.parent().op('visuals/particles').par.Turbulence
  - name: Instparticlessize
    style: Float
    label: Size
    default: 0.4
    clampMin: true
    clampMax: true
    help: 'Size of each particle: 0 = fine dust, 1 = large glowing dots.'
    value: ~me.parent().op('visuals/particles').par.Size
  - name: Instparticlescolour
    style: Menu
    label: Colour
    default: aurora
    menuSource: me.parent().op('visuals/particles').par.Colour
    help: 'Colour palette: Aurora (green-violet), Ocean (blue-cyan), Ember (red-gold), Moon (white-silver).'
    value: ~me.parent().op('visuals/particles').par.Colour
  - name: Instparticlestrails
    style: Float
    label: Trails
    default: 0.6
    clampMin: true
    clampMax: true
    help: 'How long the particles leave a glowing trail: 0 = none, 1 = long streaks.'
    value: ~me.parent().op('visuals/particles').par.Trails
  - name: Hinstvideo
    style: Header
    label: Video Feedback
  - name: Instvideovisible
    style: Toggle
    label: 'On'
    help: 'Show the video feedback. MIDI: show / hide / toggle video.'
    value: ~me.parent().op('visuals/video').par.Visible
  - name: Instvideopreset
    style: Menu
    label: Preset
    default: echo
    menuSource: me.parent().op('visuals/video').par.Preset
    help: 'A starting look: Clean (the image, lightly echoed), Echo (trails that drift outward), Abstract (melting colour, the dancer dissolved). Choosing one sets the five settings below.'
    value: ~me.parent().op('visuals/video').par.Preset
  - name: Instvideoreset
    style: Pulse
    label: Reset to Preset
    help: Put the five settings back to the chosen preset.
  - name: Instvideoecho
    style: Menu
    label: Echo
    default: auto
    menuSource: me.parent().op('visuals/video').par.Echo
    help: 'What leaves the trails. Dancer: only the dancer repeats (needs body tracking with Body Mask on, and Source: Webcam). Movement: only what moves repeats. Whole Picture: classic video feedback, the whole image fed back into itself. Auto: Dancer when available, otherwise Movement.'
    value: ~me.parent().op('visuals/video').par.Echo
  - name: Instvideofeedback
    style: Float
    label: Feedback
    default: 0.7
    clampMin: true
    clampMax: true
    help: 'How long the image echoes: 0 = no echo, 1 = very long trails.'
    value: ~me.parent().op('visuals/video').par.Feedback
  - name: Instvideozoom
    style: Float
    label: Zoom
    default: 0.1
    min: -1.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    help: 'Which way the echoes move: above 0 they grow outward, below 0 they shrink inward, 0 = they stay in place.'
    value: ~me.parent().op('visuals/video').par.Zoom
  - name: Instvideodistortion
    style: Float
    label: Distortion
    default: 0.1
    clampMin: true
    clampMax: true
    help: 'How much the echoes ripple and bend: 0 = straight, 1 = melting.'
    value: ~me.parent().op('visuals/video').par.Distortion
  - name: Instvideocolour
    style: Float
    label: Colour
    default: 0.1
    clampMin: true
    clampMax: true
    help: 'Colour treatment: 0 = natural colour, 1 = echoes shift through the rainbow and glow.'
    value: ~me.parent().op('visuals/video').par.Colour
  - name: Instvideomix
    style: Float
    label: Mix
    default: 0.75
    clampMin: true
    clampMax: true
    help: Balance between the plain video (0) and the echoes (1).
    value: ~me.parent().op('visuals/video').par.Mix
  - name: Hinstvideosource
    style: Header
    label: Video Source
  - name: Instvideosource
    style: Menu
    label: Source
    default: webcam
    menuSource: me.parent().op('visuals/video').par.Source
    help: 'Webcam: the camera image (from body tracking when it is on, otherwise from inputs > Camera). Video File: the file below. Test Pattern: a moving shape, to try the effect without a camera.'
    value: ~me.parent().op('visuals/video').par.Source
  - name: Instvideostatus
    style: Str
    label: Status
    readOnly: true
    help: What the instrument is showing now.
    value: ~me.parent().op('visuals/video').par.Status
  - name: Hinstnoise
    style: Header
    label: Noise
  - name: Instnoisevisible
    style: Toggle
    label: 'On'
    help: 'Show the noise patterns. MIDI: show / hide / toggle noise.'
    value: ~me.parent().op('visuals/noise').par.Visible
  - name: Instnoisepreset
    style: Menu
    label: Preset
    default: smoke
    menuSource: me.parent().op('visuals/noise').par.Preset
    help: 'A starting look: Smoke (slow grey clouds), Lava (warm, slowly twisting), Storm (fast, detailed, neon). Choosing one sets the six settings below.'
    value: ~me.parent().op('visuals/noise').par.Preset
  - name: Instnoisereset
    style: Pulse
    label: Reset to Preset
    help: Put the six settings back to the chosen preset.
  - name: Instnoisescale
    style: Float
    label: Scale
    default: 0.6
    clampMin: true
    clampMax: true
    help: 'Size of the pattern: 0 = fine grain, 1 = big slow shapes.'
    value: ~me.parent().op('visuals/noise').par.Scale
  - name: Instnoisespeed
    style: Float
    label: Speed
    default: 0.2
    clampMin: true
    clampMax: true
    help: 'How fast the pattern changes: 0 = almost still, 1 = boiling.'
    value: ~me.parent().op('visuals/noise').par.Speed
  - name: Instnoisedetail
    style: Float
    label: Detail
    default: 0.5
    clampMin: true
    clampMax: true
    help: 'How much fine detail sits on the big shapes: 0 = soft and smooth, 1 = rough and grainy.'
    value: ~me.parent().op('visuals/noise').par.Detail
  - name: Instnoisewarp
    style: Float
    label: Warp
    default: 0.3
    clampMin: true
    clampMax: true
    help: 'How much the pattern twists and folds into itself: 0 = plain noise, 1 = marbled swirls.'
    value: ~me.parent().op('visuals/noise').par.Warp
  - name: Instnoisefeedback
    style: Float
    label: Feedback
    default: 0.6
    clampMin: true
    clampMax: true
    help: 'How long the pattern leaves trails as it drifts outward: 0 = none, 1 = long smears.'
    value: ~me.parent().op('visuals/noise').par.Feedback
  - name: Instnoisecolour
    style: Menu
    label: Colour
    default: smoke
    menuSource: me.parent().op('visuals/noise').par.Colour
    help: 'Colour palette: Smoke (grey-white), Lava (red-gold), Ocean (blue-cyan), Neon (violet-cyan-pink).'
    value: ~me.parent().op('visuals/noise').par.Colour
  Composition:
  - name: Hcompparticles
    style: Header
    label: Particles
  - name: Compparticlesvisible
    style: Toggle
    label: 'On'
    default: true
    help: 'Show the particles. MIDI: show / hide / toggle particles.'
    value: ~me.parent().op('visuals/particles').par.Visible
  - name: Compparticlesopacity
    style: Float
    label: Opacity
    default: 1
    clampMin: true
    clampMax: true
    help: 'How strongly this instrument shows in the output: 0 = invisible, 1 = full.'
    value: ~me.parent().op('visuals/particles').par.Opacity
  - name: Compparticlesblend
    style: Menu
    label: Blend
    default: add
    menuSource: me.parent().op('visuals/particles').par.Blend
    help: 'How it joins the instruments below it. Normal: covers them (dark parts too). Add: adds its light to theirs, so dark parts let the ones below show through.'
    value: ~me.parent().op('visuals/particles').par.Blend
  - name: Compparticlesorder
    style: Int
    label: Order
    default: 2
    min: 1.0
    max: 9.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 9.0
    help: 'Stacking: an instrument with a higher Order is drawn on top of one with a lower Order.'
    value: ~me.parent().op('visuals/particles').par.Order
  - name: Hcompvideo
    style: Header
    label: Video Feedback
  - name: Compvideovisible
    style: Toggle
    label: 'On'
    help: 'Show the video feedback. MIDI: show / hide / toggle video.'
    value: ~me.parent().op('visuals/video').par.Visible
  - name: Compvideoopacity
    style: Float
    label: Opacity
    default: 1
    clampMin: true
    clampMax: true
    help: 'How strongly this instrument shows in the output: 0 = invisible, 1 = full.'
    value: ~me.parent().op('visuals/video').par.Opacity
  - name: Compvideoblend
    style: Menu
    label: Blend
    default: normal
    menuSource: me.parent().op('visuals/video').par.Blend
    help: 'How it joins the instruments below it. Normal: covers them (dark parts too). Add: adds its light to theirs, so dark parts let the ones below show through.'
    value: ~me.parent().op('visuals/video').par.Blend
  - name: Compvideoorder
    style: Int
    label: Order
    default: 1
    min: 1.0
    max: 9.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 9.0
    help: 'Stacking: an instrument with a higher Order is drawn on top of one with a lower Order.'
    value: ~me.parent().op('visuals/video').par.Order
  - name: Hcompnoise
    style: Header
    label: Noise
  - name: Compnoisevisible
    style: Toggle
    label: 'On'
    help: 'Show the noise patterns. MIDI: show / hide / toggle noise.'
    value: ~me.parent().op('visuals/noise').par.Visible
  - name: Compnoiseopacity
    style: Float
    label: Opacity
    default: 1
    clampMin: true
    clampMax: true
    help: 'How strongly this instrument shows in the output: 0 = invisible, 1 = full.'
    value: ~me.parent().op('visuals/noise').par.Opacity
  - name: Compnoiseblend
    style: Menu
    label: Blend
    default: add
    menuSource: me.parent().op('visuals/noise').par.Blend
    help: 'How it joins the instruments below it. Normal: covers them (dark parts too). Add: adds its light to theirs, so dark parts let the ones below show through.'
    value: ~me.parent().op('visuals/noise').par.Blend
  - name: Compnoiseorder
    style: Int
    label: Order
    default: 1
    min: 1.0
    max: 9.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 9.0
    help: 'Stacking: an instrument with a higher Order is drawn on top of one with a lower Order.'
    value: ~me.parent().op('visuals/noise').par.Order
  - name: Hcompshapes
    style: Header
    label: Shapes (4 Layers)
  - name: Compshapesvisible
    style: Toggle
    label: 'On'
    help: 'Show the four shape layers (layer1 ... layer4, set on their own pages and by MIDI). Off by default. MIDI: show / hide / toggle shapes.'
    value: ~me.parent().op('visuals/shapes').par.Visible
  - name: Compshapesopacity
    style: Float
    label: Opacity
    default: 1
    clampMin: true
    clampMax: true
    help: 'How strongly this instrument shows in the output: 0 = invisible, 1 = full.'
    value: ~me.parent().op('visuals/shapes').par.Opacity
  - name: Compshapesblend
    style: Menu
    label: Blend
    default: add
    menuSource: me.parent().op('visuals/shapes').par.Blend
    help: 'How it joins the instruments below it. Normal: covers them (dark parts too). Add: adds its light to theirs, so dark parts let the ones below show through.'
    value: ~me.parent().op('visuals/shapes').par.Blend
  - name: Compshapesorder
    style: Int
    label: Order
    default: 3
    min: 1.0
    max: 9.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 9.0
    help: 'Stacking: an instrument with a higher Order is drawn on top of one with a lower Order.'
    value: ~me.parent().op('visuals/shapes').par.Order
  Movement:
  - name: Hmovemovement
    style: Header
    label: Mapping Preset
  - name: Movemappingspreset
    style: Menu
    label: Preset
    default: A
    menuSource: me.parent().op('mappings').par.Preset
    help: Which set of 8 mappings is active. Edits are saved into the chosen preset at once.
    value: ~me.parent().op('mappings').par.Preset
  - name: Hmoveslots14
    style: Header
    label: Mappings 1-4
  - name: Movemappingsmap1on
    style: Toggle
    label: 1 On
    help: Mapping 1 is used while on.
    value: ~me.parent().op('mappings').par.Map1on
  - name: Movemappingsmap1signal
    style: StrMenu
    label: 1 Movement
    menuSource: me.parent().op('mappings').par.Map1signal
    help: The movement signal that drives this mapping. Pick from the menu or type a signal name.
    value: ~me.parent().op('mappings').par.Map1signal
  - name: Movemappingsmap1target
    style: StrMenu
    label: 1 Visual
    menuSource: me.parent().op('mappings').par.Map1target
    help: The visual value it changes. Choosing one sets From and To to its usual range.
    value: ~me.parent().op('mappings').par.Map1target
  - name: Movemappingsmap2on
    style: Toggle
    label: 2 On
    help: Mapping 2 is used while on.
    value: ~me.parent().op('mappings').par.Map2on
  - name: Movemappingsmap2signal
    style: StrMenu
    label: 2 Movement
    menuSource: me.parent().op('mappings').par.Map2signal
    help: The movement signal that drives this mapping. Pick from the menu or type a signal name.
    value: ~me.parent().op('mappings').par.Map2signal
  - name: Movemappingsmap2target
    style: StrMenu
    label: 2 Visual
    menuSource: me.parent().op('mappings').par.Map2target
    help: The visual value it changes. Choosing one sets From and To to its usual range.
    value: ~me.parent().op('mappings').par.Map2target
  - name: Movemappingsmap3on
    style: Toggle
    label: 3 On
    help: Mapping 3 is used while on.
    value: ~me.parent().op('mappings').par.Map3on
  - name: Movemappingsmap3signal
    style: StrMenu
    label: 3 Movement
    menuSource: me.parent().op('mappings').par.Map3signal
    help: The movement signal that drives this mapping. Pick from the menu or type a signal name.
    value: ~me.parent().op('mappings').par.Map3signal
  - name: Movemappingsmap3target
    style: StrMenu
    label: 3 Visual
    menuSource: me.parent().op('mappings').par.Map3target
    help: The visual value it changes. Choosing one sets From and To to its usual range.
    value: ~me.parent().op('mappings').par.Map3target
  - name: Movemappingsmap4on
    style: Toggle
    label: 4 On
    help: Mapping 4 is used while on.
    value: ~me.parent().op('mappings').par.Map4on
  - name: Movemappingsmap4signal
    style: StrMenu
    label: 4 Movement
    menuSource: me.parent().op('mappings').par.Map4signal
    help: The movement signal that drives this mapping. Pick from the menu or type a signal name.
    value: ~me.parent().op('mappings').par.Map4signal
  - name: Movemappingsmap4target
    style: StrMenu
    label: 4 Visual
    menuSource: me.parent().op('mappings').par.Map4target
    help: The visual value it changes. Choosing one sets From and To to its usual range.
    value: ~me.parent().op('mappings').par.Map4target
  - name: Hmoveslots58
    style: Header
    label: Mappings 5-8
  - name: Movemappingsmap5on
    style: Toggle
    label: 5 On
    help: Mapping 5 is used while on.
    value: ~me.parent().op('mappings').par.Map5on
  - name: Movemappingsmap5signal
    style: StrMenu
    label: 5 Movement
    menuSource: me.parent().op('mappings').par.Map5signal
    help: The movement signal that drives this mapping. Pick from the menu or type a signal name.
