    - Preset C
    - Preset D
    help: Preset to copy into. Its mappings are replaced.
  - name: Copy
    style: Pulse
    label: Copy Preset
    help: Copy every mapping of Copy From into Copy To.
  - name: Clear
    style: Pulse
    label: Clear Current Preset
    startSection: true
    help: Turn off and empty all 8 mappings of the current preset.
  - name: Refresh
    style: Pulse
    label: Refresh Menus
    help: Update the Movement menus with signals that appeared since (e.g. a new OSC address).
parameters:
  parentshortcut: Mappings
  opshortcut: Mappings
sequences:
  ext:
  - object: op('./MappingsExt').module.MappingsExt(me)
    name: Mappings
    promote: true
color: [0.3, 0.5, 0.9]
tags:
- tdxn
operators:
- name: presets
  type: tableDAT
  parameters:
    file: project1/mappings/presets.tsv
    syncfile: true
    rows: 33
    cols: 9
  position: [0, -400]
  color: [0.9, 0.3, 0.4]
  tags:
  - tsv
- name: MappingsExt
  type: textDAT
  parameters:
    file: project1/mappings/MappingsExt.py
- name: assignments
  type: tableDAT
  position: [400, -400]
  color: [0.67, 0.67, 0.67]
  dat_content:
  - - signal
    - target
    - in_min
    - in_max
    - out_min
    - out_max
    - smoothing
  - - pose_hand_l
    - layer1.scale
    - '0'
    - '1'
    - '0.5'
    - '2'
    - '0.1'
  - - pose_hand_r
    - layer2.scale
    - '0'
    - '1'
    - '0.5'
    - '2'
    - '0.1'
  - - pose_x
    - layer1.x
    - '0'
    - '1'
    - '-1'
    - '1'
    - '0.1'
  - - pose_spread
    - layer1.opacity
    - '0'
    - '1'
    - '0.2'
    - '1'
    - '0.1'
  dat_content_format: table
- name: midi_preset
  type: selectCHOP
  parameters:
    chops: ../engine/live
    channames: mapping_preset
    autoexportroot: =parent()
  position: [0, -800]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: signal_menu
  type: tableDAT
  position: [800, -400]
  color: [0.67, 0.67, 0.67]
  tags:
  - tdxn_exclude:dat_content
- name: target_menu
  type: tableDAT
  position: [1200, -400]
  color: [0.67, 0.67, 0.67]
  tags:
  - tdxn_exclude:dat_content
- name: mapping_logic
  type: textDAT
  parameters:
    file: project1/mappings/mapping_logic.py
  position: [400, 0]
- name: mapping_changed
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: '*'
    builtin: false
    file: project1/mappings/mapping_changed.py
    syncfile: true
  position: [800, 0]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: trigger_presets
  type: tableDAT
  parameters:
    file: project1/mappings/trigger_presets.tsv
    syncfile: true
    rows: 33
    cols: 7
  position: [1600, -400]
  color: [0.9, 0.3, 0.4]
  tags:
  - tsv
- name: trigger_does_menu
  type: tableDAT
  position: [2400, -400]
  color: [0.67, 0.67, 0.67]
  dat_content:
  - - pulse
    - Pulse (grow)
  - - spin
    - Spin
  - - sides
    - More sides
  - - jump
    - Jump
  - - flash
    - Flash colour
  dat_content_format: table
- name: trigger_when_menu
  type: tableDAT
  position: [2000, -400]
  color: [0.67, 0.67, 0.67]
  dat_content:
  - - midi
    - MIDI note
  - - serial_w1_hit
    - 'Wearable 1: hit'
  - - serial_w1_btn
    - 'Wearable 1: button'
  - - serial_w2_hit
    - 'Wearable 2: hit'
  - - serial_w2_btn
    - 'Wearable 2: button'
  - - serial_w3_hit
    - 'Wearable 3: hit'
  - - serial_w3_btn
    - 'Wearable 3: button'
  dat_content_format: table
- name: midi_preset_changed
  type: chopexecuteDAT
  parameters:
    fromop: =parent()
    chop: midi_preset
    file: project1/mappings/midi_preset_changed.py
    syncfile: true
  position: [400, -800]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
annotations:
- name: annotate1
  mode: annotate
  title: Mapping page (8 slots, 8 triggers, presets A-D)
  text: MappingsExt + mapping_logic turn the slots into assignments (read by the engine). presets holds A-D. trigger_presets holds each preset's 8 triggers (read directly by the engine; trigger_when_menu / trigger_does_menu feed their menus). signal_menu / target_menu feed the slot menus (rebuilt by RefreshMenus, in the current language). midi_preset follows the engine's mapping_preset channel so a MIDI note can switch presets during the song.
  position: [-70, -870]
  size: [2670, 1130]
  color: [0.45, 0.45, 0.45]
