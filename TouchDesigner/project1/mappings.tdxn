format: tdxn
version: '2.2'
build: 5
generator: Embody/6.2.76
td_build: 099.2025.32280
network_path: /project1/mappings
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  tableDAT:
    size: [130, 90]
  textDAT:
    parameters:
      language: python
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
type: baseCOMP
custom_pars:
  Mappings:
  - name: Preset
    style: Menu
    default: A
    menuNames:
    - A
    - B
    - C
    - D
    menuLabels:
    - Preset A
    - Preset B
    - Preset C
    - Preset D
    help: Which set of 8 mappings is active. Edits are saved into the chosen preset at once.
  - name: Followmidi
    style: Toggle
    label: Follow MIDI
    default: true
    help: 'On: a MIDI assignment row "set mapping.preset 1-4" switches the preset (A-D) at that moment of the song. Off: only this menu switches it.'
  - name: Presetnotea
    style: Int
    label: Note for Preset A
    startSection: true
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: 'The MIDI note in the song that switches to preset A (needs Follow MIDI on). -1: none.'
  - name: Presetnoteb
    style: Int
    label: Note for Preset B
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: 'The MIDI note in the song that switches to preset B (needs Follow MIDI on). -1: none.'
  - name: Presetnotec
    style: Int
    label: Note for Preset C
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: 'The MIDI note in the song that switches to preset C (needs Follow MIDI on). -1: none.'
  - name: Presetnoted
    style: Int
    label: Note for Preset D
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: 'The MIDI note in the song that switches to preset D (needs Follow MIDI on). -1: none.'
  Triggers:
  - name: Trig1on
    style: Toggle
    label: 1 On
    startSection: true
    help: Trigger 1 is used while on.
    value: true
  - name: Trig1when
    style: Menu
    label: 1 When
    default: midi
    menuSource: tdu.TableMenu(me.op('trigger_when_menu'), labelCol=1, includeFirstRow=True)
    help: 'What sets it off: a MIDI note of the song, or a wearable hit or button.'
  - name: Trig1note
    style: Int
    label: 1 Note
    default: 60
    max: 127.0
    clampMin: true
    clampMax: true
    normMax: 127.0
    help: The MIDI note number (0-127) when When is MIDI note. midi_monitor shows the numbers as the song plays.
  - name: Trig1does
    style: Menu
    label: 1 Does
    default: pulse
    menuSource: tdu.TableMenu(me.op('trigger_does_menu'), labelCol=1, includeFirstRow=True)
    help: What the Trigger Shape does each time.
  - name: Trig1amount
    style: Float
    label: 1 Amount
    default: 0.5
    min: -180.0
    max: 180.0
    normMax: 2.0
    help: 'How much: Pulse = how much bigger (0.5 = half again), Spin = degrees, More sides = sides added, Jump = how far, Flash = how strong (0-1).'
  - name: Trig2on
    style: Toggle
    label: 2 On
    startSection: true
    help: Trigger 2 is used while on.
    value: true
  - name: Trig2when
