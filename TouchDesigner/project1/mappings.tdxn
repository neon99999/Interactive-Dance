format: tdxn
version: '2.2'
build: 2
generator: Embody/6.2.76
td_build: 099.2025.32280
network_path: /project1/mappings
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  tableDAT:
    size: [130, 90]
  textDAT:
    parameters:
      language: python
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
type: baseCOMP
custom_pars:
  Mappings:
  - name: Preset
    style: Menu
    default: A
    menuNames:
    - A
    - B
    - C
    - D
    menuLabels:
    - Preset A
    - Preset B
    - Preset C
    - Preset D
    help: Which set of 8 mappings is active. Edits are saved into the chosen preset at once.
  - name: Followmidi
    style: Toggle
    label: Follow MIDI
    default: true
    help: 'On: a MIDI assignment row "set mapping.preset 1-4" switches the preset (A-D) at that moment of the song. Off: only this menu switches it.'
  Mappings 1-4:
  - name: Map1on
    style: Toggle
    label: 1 On
    startSection: true
    help: Mapping 1 is used while on.
    value: true
  - name: Map1signal
    style: StrMenu
    label: 1 Movement
    menuSource: tdu.TableMenu(me.op('signal_menu'), labelCol=1, includeFirstRow=True)
    help: The movement signal that drives this mapping. Pick from the menu or type a signal name.
    value: pose_hand_l
  - name: Map1target
    style: StrMenu
    label: 1 Visual
    menuSource: tdu.TableMenu(me.op('target_menu'), labelCol=1, includeFirstRow=True)
    help: The visual value it changes. Choosing one sets From and To to its usual range.
    value: layer1.scale
  - name: Map1from
    style: Float
    label: 1 From
    normMin: -1.0
    help: Visual value when the movement is at its lowest.
    value: 0.5
  - name: Map1to
    style: Float
    label: 1 To
    default: 1
    normMin: -1.0
    help: Visual value when the movement is at its highest.
    value: 2
  - name: Map1smooth
    style: Float
    label: 1 Smoothing
    default: 0.1
    clampMin: true
    normMax: 2.0
    help: 'Seconds the visual takes to follow the movement. 0: instant.'
  - name: Map1sens
    style: Float
    label: 1 Sensitivity
    default: 1
    min: 0.1
    clampMin: true
    normMin: 0.5
    normMax: 5.0
    help: 'How much movement reaches To: 1 = the full movement, 2 = half of it.'
  - name: Map2on
    style: Toggle
    label: 2 On
    startSection: true
    help: Mapping 2 is used while on.
    value: true
  - name: Map2signal
    style: StrMenu
    label: 2 Movement
    menuSource: tdu.TableMenu(me.op('signal_menu'), labelCol=1, includeFirstRow=True)
    help: The movement signal that drives this mapping. Pick from the menu or type a signal name.
    value: pose_hand_r
  - name: Map2target
    style: StrMenu
    label: 2 Visual
    menuSource: tdu.TableMenu(me.op('target_menu'), labelCol=1, includeFirstRow=True)
    help: The visual value it changes. Choosing one sets From and To to its usual range.
    value: layer2.scale
  - name: Map2from
    style: Float
    label: 2 From
    normMin: -1.0
    help: Visual value when the movement is at its lowest.
    value: 0.5
  - name: Map2to
    style: Float
    label: 2 To
    default: 1
    normMin: -1.0
    help: Visual value when the movement is at its highest.
    value: 2
  - name: Map2smooth
