parameters:
  parentshortcut: Mappings
  opshortcut: Mappings
sequences:
  ext:
  - object: op('./MappingsExt').module.MappingsExt(me)
    name: Mappings
    promote: true
color: [0.3, 0.5, 0.9]
tags:
- tdxn
operators:
- name: presets
  type: tableDAT
  parameters:
    file: project1/mappings/presets.tsv
    syncfile: true
    rows: 81
    cols: 9
  position: [0, -400]
  color: [0.9, 0.3, 0.4]
  tags:
  - tsv
- name: menu_items
  type: tableDAT
  position: [800, -800]
  color: [0.67, 0.67, 0.67]
  dat_content:
  - - kind
    - key
    - name
    - label
  - - source
    - ''
    - wearable1
