format: tdxn
version: '2.2'
build: 6
generator: Embody/6.2.76
td_build: 099.2025.32280
network_path: /project1/phases
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  tableDAT:
    size: [130, 90]
  textDAT:
    parameters:
      language: python
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
type: baseCOMP
custom_pars:
  Phases:
  - name: Phase
    style: Menu
    default: '1'
    menuNames:
    - '1'
    - '2'
    - '3'
    - '4'
    - '5'
    - '6'
    - '7'
    - '8'
    menuLabels:
    - Phase 1
    - Phase 2
    - Phase 3
    - Phase 4
    - Phase 5
    - Phase 6
    - Phase 7
    - Phase 8
    help: The phase shown below. Follow MIDI switches it when the song plays a phase note. Edits are saved into this phase at once.
  - name: Followmidi
    style: Toggle
    label: Follow MIDI
    default: true
    help: 'On: a phase note of the song switches the phase (before the first one: phase 1). Off: only the Phase menu switches it.'
  - name: Phasenote1
    style: Int
    label: Note for Phase 1
    startSection: true
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: The MIDI note of the song that starts phase 1 (-1 = none).
  - name: Phasenote2
    style: Int
    label: Note for Phase 2
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: The MIDI note of the song that starts phase 2 (-1 = none).
  - name: Phasenote3
    style: Int
    label: Note for Phase 3
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: The MIDI note of the song that starts phase 3 (-1 = none).
  - name: Phasenote4
    style: Int
    label: Note for Phase 4
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: The MIDI note of the song that starts phase 4 (-1 = none).
  - name: Phasenote5
    style: Int
    label: Note for Phase 5
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: The MIDI note of the song that starts phase 5 (-1 = none).
  - name: Phasenote6
    style: Int
    label: Note for Phase 6
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: The MIDI note of the song that starts phase 6 (-1 = none).
  - name: Phasenote7
    style: Int
    label: Note for Phase 7
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: The MIDI note of the song that starts phase 7 (-1 = none).
  - name: Phasenote8
    style: Int
    label: Note for Phase 8
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: The MIDI note of the song that starts phase 8 (-1 = none).
  - name: Copyto
    style: Menu
    label: Copy To
    startSection: true
    default: '2'
    menuNames:
    - '1'
    - '2'
    - '3'
    - '4'
    - '5'
    - '6'
    - '7'
    - '8'
    menuLabels:
    - Phase 1
    - Phase 2
    - Phase 3
    - Phase 4
    - Phase 5
    - Phase 6
    - Phase 7
    - Phase 8
    help: The phase that Copy Phase writes into.
  - name: Copy
    style: Pulse
    label: Copy Phase
    help: Copy the shown phase into Copy To.
  - name: Clear
    style: Pulse
    label: Clear Phase
    help: Empty every event of the shown phase.
  Events:
  - name: Ev1on
    style: Toggle
    label: 1 On
    startSection: true
    help: Use this event in the phase.
    value: true
  - name: Ev1name
    style: Str
    label: 1 Name
    help: 'The name written in the shape: what the action is, e.g. punch explode.'
    value: punch
  - name: Ev1shape
    style: Menu
    label: 1 Shape
    default: rectangle
    menuNames:
    - rectangle
    - circle
    - triangle
    menuLabels:
    - Rectangle
    - Circle
    - Triangle
    help: The placeholder shape.
  - name: Ev1colour
    style: Menu
    label: 1 Colour
    default: white
    menuNames:
    - white
    - red
    - orange
    - yellow
    - green
    - cyan
    - blue
    - magenta
    menuLabels:
    - White
    - Red
    - Orange
    - Yellow
    - Green
    - Cyan
    - Blue
    - Magenta
    help: The colour of the shape.
    value: cyan
  - name: Ev1x
    style: Float
    label: 1 X
    normMin: -1.0
    help: Position left (-1) to right (1).
    value: -0.4
  - name: Ev1y
    style: Float
    label: 1 Y
    normMin: -1.0
    help: Position bottom (-1) to top (1).
  - name: Ev1size
    style: Float
    label: 1 Size
    default: 0.3
    clampMin: true
    normMin: 0.05
    help: Size, as a part of the screen height.
    value: 0.35
  - name: Ev1show
    style: Menu
    label: 1 Show
    default: timed
    menuNames:
    - always
    - toggle
    - timed
    menuLabels:
    - Always
    - Toggle
    - For a time
    help: 'Always: on for the whole phase. Toggle: the trigger shows it, the trigger again hides it. For a time: the trigger shows it for Time seconds.'
    value: toggle
  - name: Ev1time
    style: Float
    label: 1 Time
    default: 1
    clampMin: true
    normMax: 10.0
    help: 'For a time: how many seconds the event stays. A new trigger starts the time again.'
    enable: false
  - name: Ev1trigger
    style: Menu
    label: 1 Trigger
    default: none
    menuSource: tdu.TableMenu(me.op('trigger_menu'), labelCol=1, includeFirstRow=True)
    help: 'What shows the event: a MIDI note of the song, or a wearable hit or button.'
    value: serial_w1_hit
  - name: Ev1note
    style: Int
    label: 1 Note
    default: 60
    max: 127.0
    clampMin: true
    clampMax: true
    normMax: 127.0
    help: The MIDI note of the song, for a MIDI trigger.
    enable: false
  - name: Ev1link1in
    style: StrMenu
    label: 1 Link 1 Movement
    default: none
    menuSource: tdu.TableMenu(me.op('link_menu'), labelCol=1, includeFirstRow=True)
    help: A continuous movement (arm tilt, body position...) that moves the shape while it is on screen.
    value: serial_w1_roll
  - name: Ev1link1prop
    style: Menu
    label: 1 Link 1 Moves
    default: rotate
    menuNames:
    - size
    - x
    - y
    - rotate
    - bright
    menuLabels:
    - Size
    - X position
    - Y position
    - Rotation
    - Brightness
    help: What the movement changes.
  - name: Ev1link1from
    style: Float
    label: 1 Link 1 From
    default: -180
    normMin: -180.0
    normMax: 180.0
    help: The value at the low end of the movement.
  - name: Ev1link1to
    style: Float
    label: 1 Link 1 To
    default: 180
    normMin: -180.0
    normMax: 180.0
    help: The value at the high end of the movement.
  - name: Ev1link2in
