parameters:
  parentshortcut: Phases
  opshortcut: Phases
sequences:
  ext:
  - object: op('./PhasesExt').module.PhasesExt(me)
    name: Phases
    promote: true
color: [0.3, 0.5, 0.9]
tags:
- tdxn
storage:
  _t:
  - $type: tuple
    $value:
    - 8.8
    - '1'
    - '1'
  - $type: tuple
    $value:
    - 9.23
    - '1'
    - '1'
  - $type: tuple
    $value:
    - 10.25
    - '1'
    - '1'
  - $type: tuple
    $value:
    - 11.25
    - '0'
    - '1'
  - $type: tuple
    $value:
    - 11.75
    - '0'
    - '1'
  - $type: tuple
    $value:
    - 18.23
    - '0'
    - '2'
operators:
- name: phases
  type: tableDAT
  parameters:
    file: project1/phases/phases.tsv
    syncfile: true
    rows: 65
    cols: 21
  position: [0, -400]
  color: [0.9, 0.3, 0.4]
  tags:
  - tsv
- name: PhasesExt
  type: textDAT
  parameters:
    file: project1/phases/PhasesExt.py
- name: link_menu
  type: tableDAT
  position: [800, -400]
  color: [0.67, 0.67, 0.67]
  dat_content:
  - - none
    - No link
  - - pose_x
    - 'Body: position left-right'
  - - pose_hand_l
    - 'Body: left hand height'
  - - pose_hand_r
    - 'Body: right hand height'
  - - pose_spread
    - 'Body: arms spread'
  - - pose_energy
    - 'Body: energy'
  - - serial_w1_roll
    - 'Wearable 1: tilt sideways'
  - - serial_w1_pitch
    - 'Wearable 1: tilt up-down'
  - - serial_w1_act
    - 'Wearable 1: activity'
  - - serial_w1_gx
    - 'Wearable 1: twist speed'
  - - serial_w1_gy
    - 'Wearable 1: tilt speed'
  - - serial_w1_gz
    - 'Wearable 1: turn speed'
  - - serial_w2_roll
    - 'Wearable 2: tilt sideways'
  - - serial_w2_pitch
    - 'Wearable 2: tilt up-down'
  - - serial_w2_act
    - 'Wearable 2: activity'
  - - serial_w2_gx
    - 'Wearable 2: twist speed'
  - - serial_w2_gy
    - 'Wearable 2: tilt speed'
  - - serial_w2_gz
    - 'Wearable 2: turn speed'
  - - serial_w3_roll
    - 'Wearable 3: tilt sideways'
  - - serial_w3_pitch
    - 'Wearable 3: tilt up-down'
  - - serial_w3_act
    - 'Wearable 3: activity'
  - - serial_w3_gx
    - 'Wearable 3: twist speed'
  - - serial_w3_gy
    - 'Wearable 3: tilt speed'
  - - serial_w3_gz
    - 'Wearable 3: turn speed'
  - - camera_motion
    - 'Camera: motion'
  - - camera_left
    - 'Camera: motion left'
  - - camera_right
    - 'Camera: motion right'
  - - sim_level
    - 'Test: level'
  dat_content_format: table
- name: event_state
  type: tableDAT
  position: [1200, -400]
  color: [0.67, 0.67, 0.67]
  tags:
  - tdxn_exclude:dat_content
- name: phase_logic
  type: textDAT
  parameters:
    file: project1/phases/phase_logic.py
  position: [400, 0]
- name: phases_frame
  type: executeDAT
  parameters:
    fromop: =parent()
    framestart: true
    file: project1/phases/phases_frame.py
    syncfile: true
  position: [1200, 0]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: trigger_menu
  type: tableDAT
  position: [400, -400]
  color: [0.67, 0.67, 0.67]
  dat_content:
  - - none
    - Nothing
  - - midi
    - MIDI note (song)
  - - serial_w1_hit
    - 'Wearable 1: hit'
  - - serial_w1_btn
    - 'Wearable 1: button'
  - - serial_w2_hit
    - 'Wearable 2: hit'
  - - serial_w2_btn
    - 'Wearable 2: button'
  - - serial_w3_hit
    - 'Wearable 3: hit'
  - - serial_w3_btn
    - 'Wearable 3: button'
  dat_content_format: table
- name: phases_changed
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: '*'
    builtin: false
    file: project1/phases/phases_changed.py
    syncfile: true
  position: [800, 0]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
annotations:
- name: annotate1
  mode: annotate
  title: Phases and placeholder events
  text: 'Phases (1-8) start on MIDI notes of the song (Follow MIDI). Each phase has 8 events: a named shape that a trigger (MIDI note, wearable hit or button) shows always / as a toggle / for a time, and 2 links that let a continuous movement move it. phases (phases.tsv) stores every phase; the Ev parameters show the Phase being edited. phases_frame runs PhasesExt.frame each frame, which writes event_state for visuals/events. Rules in phase_logic (tests/test_phases.py).'
  position: [-70, -470]
  size: [1460, 700]
  color: [0.45, 0.45, 0.45]
