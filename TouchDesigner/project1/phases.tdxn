    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: The MIDI note of the song that starts phase 9 (-1 = none).
  - name: Phasenote10
    style: Int
    label: Note for Phase 10
    default: -1
    min: -1.0
    max: 127.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    normMax: 127.0
    help: The MIDI note of the song that starts phase 10 (-1 = none).
parameters:
  parentshortcut: Phases
  opshortcut: Phases
sequences:
  ext:
  - object: op('./PhasesExt').module.PhasesExt(me)
    name: Phases
    promote: true
color: [0.3, 0.5, 0.9]
tags:
- tdxn
storage:
  _t:
  - $type: tuple
    $value:
    - 8.8
    - '1'
    - '1'
  - $type: tuple
    $value:
    - 9.23
    - '1'
    - '1'
  - $type: tuple
    $value:
    - 10.25
    - '1'
    - '1'
  - $type: tuple
    $value:
    - 11.25
    - '0'
    - '1'
  - $type: tuple
    $value:
    - 11.75
    - '0'
    - '1'
  - $type: tuple
    $value:
    - 18.23
    - '0'
    - '2'
operators:
- name: PhasesExt
  type: textDAT
  parameters:
    file: project1/phases/PhasesExt.py
- name: phase_keys
  type: keyboardinDAT
  parameters:
    callbacks: phase_keys_callbacks
    fromop: =parent()
  position: [400, -400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_read_only: true
- name: phase_logic
  type: textDAT
  parameters:
    file: project1/phases/phase_logic.py
  position: [400, 0]
- name: phases_frame
  type: executeDAT
  parameters:
    fromop: =parent()
    framestart: true
    file: project1/phases/phases_frame.py
    syncfile: true
  position: [1200, 0]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: phase_settings
  type: tableDAT
  parameters:
    file: project1/phases/phase_settings.tsv
    syncfile: true
    rows: 578
  position: [0, -400]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - tsv
- name: phases_changed
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: '*'
    builtin: false
    file: project1/phases/phases_changed.py
    syncfile: true
  position: [800, 0]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: phase_keys_callbacks
  type: textDAT
  parameters:
    file: project1/phases/phase_keys_callbacks.py
  flags:
  - viewer
  position: [400, -520]
  dock: phase_keys
annotations:
- name: annotate1
  mode: annotate
  title: Phases and their settings
  text: 'Phases (1-10) start on MIDI notes of the song (Follow MIDI), from the Phase menu or from the number keys (phase_keys: 1-9, 0 = 10; only while the Stage picture or tiles have focus). Each phase keeps a snapshot of every instrument''s settings in phase_settings; the mappings keep one preset per phase (Mappings Preset = phase). phases_frame runs PhasesExt.frame: follows the song, keeps changed settings, autosaves shows/autosave.json. Rules in phase_logic (tests/test_phases.py).'
  position: [-70, -600]
  size: [1460, 830]
  color: [0.45, 0.45, 0.45]
