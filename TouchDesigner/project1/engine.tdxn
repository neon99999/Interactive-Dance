annotations:
- name: annotate1
  mode: annotate
  title: Assignments (edit these)
  text: 'midi_assignments: note, target, action, value, duration (16 rows). input_assignments: signal, target, in/out range, smoothing. Problems are listed in assignment_errors. engine_buttons: the Assignments page buttons open these tables.'
  position: [-70, -870]
  size: [270, 1030]
  color: [0.45, 0.45, 0.45]
- name: annotate2
  mode: annotate
