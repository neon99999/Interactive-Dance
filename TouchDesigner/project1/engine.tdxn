  inputs:
  - datto_live
- name: engine
  type: executeDAT
  parameters:
    fromop: =parent()
    framestart: true
    file: project1/engine/engine.py
    syncfile: true
  position: [800, -200]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: datto_live
  type: dattoCHOP
  parameters:
    dat: live_values
    rowindexend: =me.inputTable.numRows - 1
    rowexpr: =re.match('.*',me.inputCell.val) != None
    colindexend: =me.inputTable.numCols - 1
    colexpr: =re.match('.*',me.inputCell.val) != None
    autoexportroot: =parent()
  position: [1600, -200]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
