format: tdxn
version: '2.2'
build: 4
generator: Embody/6.2.76
td_build: 099.2025.32280
network_path: /project1/engine
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  tableDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
type: baseCOMP
custom_pars:
  Assignments:
  - name: Editmidi
    style: Pulse
    label: Edit MIDI Assignments
    help: Open the MIDI assignment table (note, target, action, value, duration) in its own window.
  - name: Editinputs
    style: Pulse
    label: Edit Input Assignments
    help: Open the input assignment table (signal, target, in_min, in_max, out_min, out_max, smoothing) in its own window.
  - name: Showerrors
    style: Pulse
    label: Show Errors
    help: Open the list of assignment rows that could not be used, with the reason. Empty means every row is fine.
  - name: Showlive
    style: Pulse
    label: Show Live Values
    help: Open a viewer of every visual value the engine is sending right now.
parameters:
  parentshortcut: Engine
  opshortcut: Engine
color: [0.3, 0.5, 0.9]
tags:
- tdxn
operators:
- name: live
  type: nullCHOP
  parameters:
    autoexportroot: =parent()
  position: [2000, -200]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - datto_live
- name: engine
  type: executeDAT
  parameters:
    fromop: =parent()
    framestart: true
    file: project1/engine/engine.py
    syncfile: true
  position: [800, -200]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: datto_live
  type: dattoCHOP
  parameters:
    dat: live_values
    rowindexend: =me.inputTable.numRows - 1
    rowexpr: =re.match('.*',me.inputCell.val) != None
    colindexend: =me.inputTable.numCols - 1
    colexpr: =re.match('.*',me.inputCell.val) != None
    autoexportroot: =parent()
  position: [1600, -200]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: show_logic
  type: textDAT
  parameters:
    file: project1/engine/show_logic.py
    syncfile: true
    language: python
  position: [800, 200]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: live_values
  type: tableDAT
  position: [1200, -200]
  tags:
  - tdxn_exclude:dat_content
- name: engine_buttons
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: '*'
    valuechange: false
    builtin: false
    file: project1/engine/engine_buttons.py
    syncfile: true
  position: [0, -800]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
