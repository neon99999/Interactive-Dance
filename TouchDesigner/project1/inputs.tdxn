format: tdxn
version: '2.2'
build: 8
generator: Embody/6.2.76
td_build: 099.2025.32280
network_path: /project1/inputs
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  analyzeTOP:
    parameters:
      format: mono32float
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  cropTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mergeCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textDAT:
    parameters:
      language: python
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
  toptoCHOP:
    parameters:
      a: ''
      autoexportroot: =parent()
      b: ''
      g: ''
      rate: =me.time.rate
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
type: baseCOMP
custom_pars:
  Simulated:
  - name: Simlevel
    style: Float
    label: Level (sim_level)
    clampMin: true
    clampMax: true
    help: 'Simulated continuous movement value 0-1, as a sensor would send. Signal name: sim_level.'
  - name: Simtrigger
    style: Momentary
    label: Trigger (sim_trigger)
    help: 'Simulated momentary trigger: 1 while held, else 0. Signal name: sim_trigger.'
  - name: Simzone
    style: Toggle
    label: Zone (sim_zone)
    help: 'Simulated spatial zone: on = a dancer is in the zone. Signal name: sim_zone.'
  - name: Simanimate
    style: Toggle
    label: Animate Level
    startSection: true
    help: Move sim_level up and down automatically (slow sine wave), to test mappings without touching the slider.
  OSC:
  - name: Oscenable
    style: Toggle
    label: Receive OSC
    help: Listen for OSC messages (UDP) on the port below. Each OSC address becomes a signal, e.g. /dancer/level -> dancer/level. Off by default.
  - name: Oscport
    style: Int
    label: OSC Port
    default: 7000
    min: 1.0
    max: 65535.0
    clampMin: true
    clampMax: true
    normMin: 1000.0
    normMax: 12000.0
    help: UDP port to listen on. The sending app or device must send to this computer on this port.
  Serial:
  - name: Serialenable
    style: Toggle
    label: Read Serial
    help: Read lines of text from a serial (USB) device such as an Arduino. Off by default.
    value: true
  - name: Serialport
    style: StrMenu
    label: Port
    menuSource: op('./serial_in').par.port
    help: Serial port of the device (COM3 on Windows, /dev/cu.usbmodem... on macOS). The menu lists the ports TouchDesigner can see.
    value: com3
  - name: Serialbaud
    style: Int
    label: Baud Rate
    default: 9600
    min: 300.0
    clampMin: true
    normMin: 9600.0
    normMax: 921600.0
    help: 'Must match the device: 921600 for the wireless receiver (NodeMCU), 115200 for a wearable plugged in by USB, or Serial.begin(...) in your own sketch.'
    value: 921600
  - name: Serialnames
    style: Str
    label: Value Names
    help: 'Names for lines of plain numbers, in order, e.g. "accel, zone" turns "0.5,1" into serial_accel and serial_zone. Blank: serial_1, serial_2 ... Lines of name=value pairs name themselves.'
  Camera:
  - name: Camerasource
    style: Menu
    label: Source
    default: 'off'
    menuNames:
    - 'off'
    - camera
    - test
    menuLabels:
    - 'Off'
    - Camera
    - Test Pattern
    help: 'Off: no camera, all camera signals 0. Camera: a webcam. Test Pattern: a moving dot, to try camera mappings without a camera.'
  - name: Cameradevice
    style: StrMenu
    label: Device
    menuSource: op('./camera_in').par.device
    help: Which camera to use. The menu lists the cameras TouchDesigner can see.
  - name: Camerasensitivity
    style: Float
    label: Sensitivity
    default: 10
    clampMin: true
    normMax: 50.0
    help: Multiplies the amount of movement seen. Raise it if camera_motion stays small; signals are clamped to 0-1 by the input assignment ranges.
  Pose:
  - name: Posesource
    style: Menu
    label: Source
    default: 'off'
    menuNames:
    - 'off'
    - camera
    - test
    menuLabels:
    - 'Off'
    - Camera (MediaPipe)
    - Test Dancer
    help: 'Off: body tracking stopped (MediaPipe does not run), all pose signals 0. Camera (MediaPipe): track a dancer with the webcam chosen below. Test Dancer: a made-up dancer that walks and waves, to try pose mappings without a camera.'
  - name: Posecamera
    style: StrMenu
    label: Webcam
    menuSource: op('./mediapipe/MediaPipe').par.Webcam
    help: Which webcam MediaPipe uses. Close other apps using it, and set the Camera page Source to Off if it uses the same webcam.
  - name: Poseflipx
    style: Toggle
    label: Flip Left/Right
    help: 'Off: pose_x is 0 at the left of the MediaPipe picture, 1 at the right. On: reversed. Use it to match pose_x to the stage as the audience sees it.'
  - name: Posesmooth
    style: Float
    label: Smoothing (s)
    startSection: true
    default: 0.1
    clampMin: true
    help: 'Time in seconds that pose signals take to follow the dancer. Raise it if values jitter, lower it if they feel late. 0: no smoothing.'
  - name: Posesensitivity
    style: Float
    label: Energy Sensitivity
    default: 1
    clampMin: true
    normMax: 5.0
    help: Multiplies pose_energy. Raise it if pose_energy stays small during big movement.
  - name: Posehold
    style: Float
    label: Hold When Lost (s)
    default: 0.5
    clampMin: true
    normMax: 2.0
    help: When MediaPipe loses the dancer for less than this many seconds, the pose signals keep their last values; after that they drop to 0.
  - name: Posezones
    style: Int
    label: Stage Zones
    startSection: true
    default: 3
    min: 1.0
    max: 5.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 5.0
    help: How many equal zones pose_x is split into, left to right (1-5). pose_zone says which one the dancer is in (1 = left), and pose_zone1 ... pose_zone5 are 1 in that zone. Shown on pose_monitor.
  - name: Posezonemargin
    style: Float
    label: Zone Margin
    default: 0.05
    max: 0.2
    clampMin: true
    clampMax: true
    normMax: 0.2
    help: 'How far past a zone border (fraction of the picture width) the dancer must go before the zone changes. Stops flicker when standing on a border. 0: change exactly at the border.'
parameters:
  parentshortcut: Inputs
  opshortcut: Inputs
color: [0.3, 0.5, 0.9]
tags:
- tdxn
operators:
- name: osc_in
  type: oscinCHOP
  parameters:
    active: =parent.Inputs.par.Oscenable
    port: =parent.Inputs.par.Oscport
    autoexportroot: =parent()
  position: [0, -800]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: signals
  type: nullCHOP
  parameters:
    autoexportroot: =parent()
  position: [4800, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - merge_signals
- name: camera_in
  type: videodeviceinTOP
  flags:
  - viewer
  position: [0, -2900]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: chop_left
  type: toptoCHOP
  parameters:
    top: analyze_left
    r: camera_left
  position: [3200, -2500]
- name: crop_left
  type: cropTOP
  parameters:
    cropright: 0.5
  position: [2400, -2500]
  inputs:
  - diff_frames
- name: pose_chop
  type: scriptCHOP
  parameters:
    callbacks: pose_chop_callbacks
    autoexportroot: =parent()
  position: [400, -4200]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: serial_in
  type: serialDAT
  parameters:
    active: =parent.Inputs.par.Serialenable
    port: =parent.Inputs.par.Serialport
    baudrate: =parent.Inputs.par.Serialbaud
    stopbits: '1'
    dtr: disable
    callbacks: serial_in_callbacks
    fromop: =parent()
  position: [0, -1600]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_read_only: true
- name: simulated
  type: constantCHOP
  parameters:
    rate: =me.time.rate
    autoexportroot: =parent()
  sequences:
    const:
    - name: sim_level
      value: =(0.5 + 0.5 * math.sin(absTime.seconds * 1.3)) if parent.Inputs.par.Simanimate else parent.Inputs.par.Simlevel
    - name: sim_trigger
      value: =float(parent.Inputs.par.Simtrigger)
    - name: sim_zone
      value: =float(parent.Inputs.par.Simzone)
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: camera_off
  type: constantTOP
  parameters:
    colorr: 0
    colorg: 0
    colorb: 0
    outputresolution: custom
    resolutionw: 160
    resolutionh: 90
  position: [0, -2500]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: chop_right
  type: toptoCHOP
  parameters:
    top: analyze_right
    r: camera_right
  position: [3200, -3300]
- name: crop_right
  type: cropTOP
  parameters:
    cropleft: 0.5
  position: [2400, -3300]
  inputs:
  - diff_frames
- name: fit_camera
  type: resolutionTOP
  parameters:
    outputresolution: custom
    resolutionw: 160
    resolutionh: 90
  position: [800, -2900]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - switch_camera
- name: camera_test
  type: circleTOP
  parameters:
    radiusx: 0.15
    radiusy: 0.15
    centerx: =0.35 * math.sin(absTime.frame / 60 * 2)
    outputresolution: custom
    resolutionw: 160
    resolutionh: 90
  position: [0, -3300]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: chop_motion
  type: toptoCHOP
  parameters:
    top: analyze_motion
    r: camera_motion
  position: [3200, -2900]
- name: diff_frames
  type: compositeTOP
  parameters:
    operand: difference
  position: [2000, -2900]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - mono_camera
  - previous_frame
- name: mono_camera
  type: monochromeTOP
  position: [1200, -2900]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - fit_camera
- name: osc_signals
  type: selectCHOP
  parameters:
    chops: ='osc_in' if parent.Inputs.par.Oscenable else ''
    autoexportroot: =parent()
  position: [400, -800]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: serial_chop
  type: dattoCHOP
  parameters:
    dat: ='serial_values' if parent.Inputs.par.Serialenable else ''
    rowindexend: =me.inputTable.numRows - 1
    rowexpr: =re.match('.*',me.inputCell.val) != None
    colindexend: =me.inputTable.numCols - 1
    colexpr: =re.match('.*',me.inputCell.val) != None
    autoexportroot: =parent()
  position: [1200, -1600]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: analyze_left
  type: analyzeTOP
  position: [2800, -2500]
  inputs:
  - crop_left
- name: merge_camera
  type: mergeCHOP
  position: [3600, -2900]
  inputs:
  - chop_motion
  - chop_left
  - chop_right
- name: pose_signals
  type: textDAT
  parameters:
    file: project1/inputs/pose_signals.py
  position: [0, -4600]
- name: serial_parse
  type: textDAT
  parameters:
    file: project1/inputs/serial_parse.py
  position: [400, -1600]
- name: analyze_right
  type: analyzeTOP
  position: [2800, -3300]
  inputs:
  - crop_right
- name: merge_signals
  type: mergeCHOP
  position: [4400, 0]
  inputs:
  - simulated
  - osc_signals
  - serial_chop
  - camera_sensitivity
  - pose_chop
- name: pose_settings
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: Posesource
    builtin: false
    file: project1/inputs/pose_settings.py
    syncfile: true
  position: [400, -4600]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: serial_values
  type: tableDAT
  position: [800, -1600]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  tags:
  - tdxn_exclude:dat_content
- name: switch_camera
  type: switchTOP
  parameters:
    index: =parent.Inputs.par.Camerasource.menuIndex
  position: [400, -2900]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - camera_off
  - camera_in
  - camera_test
- name: analyze_motion
  type: analyzeTOP
  position: [2800, -2900]
  inputs:
  - diff_frames
- name: previous_frame
  type: cacheTOP
  parameters:
    cachesize: 2
    outputindex: -1
  position: [1600, -3300]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - mono_camera
- name: camera_sensitivity
  type: mathCHOP
  parameters:
    gain: =parent.Inputs.par.Camerasensitivity
    autoexportroot: =parent()
  position: [4000, -2900]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - merge_camera
- name: pose_chop_callbacks
  type: textDAT
  parameters:
    file: project1/inputs/pose_chop_callbacks.py
  flags:
  - viewer
  position: [400, -4320]
  dock: pose_chop
- name: serial_in_callbacks
  type: textDAT
  parameters:
    file: project1/inputs/serial_in_callbacks.py
  flags:
  - viewer
  position: [0, -1720]
  dock: serial_in
annotations:
- name: annotate1
  mode: annotate
  title: Simulated movement
  text: sim_level (0-1), sim_trigger, sim_zone from the Simulated page. Use them to try mappings without sensors.
  position: [-70, -70]
  size: [400, 330]
  color: [0.45, 0.45, 0.45]
- name: annotate2
  mode: annotate
  title: OSC
  text: 'Each OSC address becomes a signal: /dancer/level -> dancer/level. osc_signals passes them on only while Receive OSC is on (OSC page: enable + port).'
  position: [-70, -870]
  size: [670, 330]
  color: [0.45, 0.45, 0.45]
- name: annotate3
  mode: annotate
  title: Serial
  text: Lines from a USB device -> serial_parse -> serial_values -> serial_* signals (Serial page).
  position: [-70, -1790]
  size: [1400, 450]
  color: [0.45, 0.45, 0.45]
- name: annotate4
  mode: annotate
  title: Camera motion
  text: 'Frame difference of a small grey camera image: camera_motion (whole frame), camera_left, camera_right (halves). Camera page: source, device, sensitivity.'
  position: [-70, -3370]
  size: [4270, 1130]
  color: [0.45, 0.45, 0.45]
- name: annotate5
  mode: annotate
  title: All signals
  text: Every source merges here. The engine reads 'signals'.
  position: [4330, -70]
  size: [670, 330]
  color: [0.45, 0.45, 0.45]
- name: annotate6
  mode: annotate
  title: Body tracking (MediaPipe)
  text: mediapipe/MediaPipe loads toxes/MediaPipe.tox (not in git; download per machine) and runs only while Pose page Source is Camera (pose_settings). pose_chop -> pose_present, pose_x, pose_hand_l, pose_hand_r, pose_spread, pose_energy (pose_signals).
  position: [-70, -4670]
  size: [670, 770]
  color: [0.45, 0.45, 0.45]
