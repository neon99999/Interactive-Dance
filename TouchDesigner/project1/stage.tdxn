annotations:
- name: annotate1
  mode: annotate
  title: Logic
  text: 'StageExt: tiles, labels, test switches (op.Stage.Open() / Close()). stage_pars: Test Track / Pattern / Dancer, Open, Close. panel_clicks: tile clicks pick the big view; bar buttons act. stage_window: the window (fills the screen). open_on_start: opens it when the project opens (Stage page, Open on Start).'
  position: [-70, 1930]
  size: [1080, 330]
  color: [0.45, 0.45, 0.45]
- name: annotate2
  mode: annotate
  title: Big view, controls and tiles
  text: 'view: the output or the clicked tile. controls: the control panel''s five tabs (a Parameter COMP showing control). tile_*: live images; a hidden instrument''s tile stays dark until clicked, so it does not cook.'
  position: [-70, 830]
  size: [2100, 370]
  color: [0.45, 0.45, 0.45]
- name: annotate3
  mode: annotate
  title: Bottom bar
  text: Play (bound to transport), Reset, playback time, Test Track / Test Pattern / Test Dancer (bound to the stage's toggles), Open / Close Output Window, English / Español.
  position: [-70, -190]
  size: [2100, 500]
  color: [0.45, 0.45, 0.45]
