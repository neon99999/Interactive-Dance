format: tdxn
version: '2.2'
build: 4
generator: Embody/6.2.76
td_build: 099.2025.32280
network_path: /project1/stage
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  buttonCOMP:
    parameters:
      clone: =op.TDTox.op('defaultCOMPs/button')
      hmode: anchors
      repocomp: =me
      resizecomp: =me
      vmode: anchors
    size: [160, 134]
  containerCOMP:
    parameters:
      bgalpha: 1
      hmode: anchors
      repocomp: =me
      resizecomp: =me
      vmode: anchors
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  outCHOP:
    parameters:
      autoexportroot: =parent()
      label: =me.name
    flags:
    - viewer
    size: [130, 90]
  panelexecuteDAT:
    parameters:
      fromop: =parent()
  parameterCHOP:
    parameters:
      autoexportroot: =parent()
      builtin: true
      custom: false
      parameters: value0
      renameto: v1
    flags:
    - viewer
    size: [130, 90]
  parameterexecuteDAT:
    parameters:
      fromop: =parent()
  textCOMP:
    parameters:
      repocomp: =me
      resizecomp: =me
  textDAT:
    parameters:
      language: python
type: containerCOMP
custom_pars:
  Stage:
  - name: Mainview
    style: Menu
    label: Big View
    default: output
    menuNames:
    - output
    - noise
    - video
    - shapes
    - particles
    - pose
    - wearable
    - midi
    menuLabels:
    - Output
    - Noise
    - Video Feedback
    - Shapes
    - Particles
    - Body Tracking
    - Wearables
    - MIDI Notes
    help: What the big view shows. Clicking a tile picks it; Output shows the final image.
  - name: Testtrack
    style: Toggle
    label: Test Track
    help: 'On: transport plays the test track and MIDI (media/test), with the demo cues at 5, 10, 15 and 20 s. Off: your Audio File and MIDI File come back.'
  - name: Testpattern
    style: Toggle
    label: Test Pattern
    help: 'On: the Video Feedback instrument is shown with the test pattern as its source. Off: its Source and On come back.'
  - name: Testdancer
    style: Toggle
    label: Test Dancer
    help: 'On: inputs Use is Test, a made-up dancer for the pose signals (no webcam needed). Off: Use comes back.'
  - name: Open
    style: Pulse
    label: Open Stage Window
    help: Open the stage window (1920 x 1080).
  - name: Close
    style: Pulse
    label: Close Stage Window
    help: Close the stage window.
  - name: Openonstart
    style: Toggle
    label: Open on Start
    default: true
    help: 'On: the stage window opens by itself when the project opens.'
parameters:
  w: 1707
  h: 996
  sizefromwindow: true
  resizecomp: =me
  repocomp: =me
  bgcolorr: 0.035
  bgcolorg: 0.04
  bgcolorb: 0.05
  bgalpha: 1
  parentshortcut: Stage
  opshortcut: Stage
sequences:
  ext:
  - object: op('./StageExt').module.StageExt(me)
    name: Stage
    promote: true
color: [0.3, 0.5, 0.9]
tags:
- tdxn
storage:
  testPrevious: {}
operators:
- name: bar
  type: containerCOMP
  parameters:
    w: 1920
    h: 72
    topanchor: 0.0666667
    alignorder: -1
    bgcolorr: 0.075
    bgcolorg: 0.085
    bgcolorb: 0.1
- name: view
  type: containerCOMP
  parameters:
    y: 432
    w: 1152
    h: 648
    rightanchor: 0.6
    bottomanchor: 0.4
    top: =parent.Stage.ext.Stage.tileTop(parent.Stage.par.Mainview.eval()) if parent.Stage.extensionsReady else None
    topfill: best
  position: [0, 900]
  children:
  - name: view_label
    type: textCOMP
    parameters:
      text: =parent.Stage.ext.Stage.viewLabel() if parent.Stage.extensionsReady else ''
      callbacks: view_label_callbacks
      fontsize: 18
      fontcolorr: 0.86
      fontcolorg: 0.88
      fontcolorb: 0.9
      textpaddingl: 10
      textpaddingr: 10
      alignx: left
      y: 612
      w: 1152
      h: 36
      hmode: anchors
      vmode: anchors
      bottomanchor: 1
      bottomoffset: -36
      bgalpha: 0.55
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  - name: view_label_callbacks
    type: textDAT
    flags:
    - viewer
    - -showDocked
    position: [0, -160]
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
    dock: view_label
    dat_content: "# Text Component callbacks\n\nfrom typing import Any, Dict\n\ndef onValueChange(comp: textCOMP, value: str, prevValue: str):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason\n\tincluding typing in the text window or changing the parameter directly. The\n\tcallback is equivalent to the onValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value,\n\t#      ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp: textCOMP):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp: textCOMP, info: Dict[str, str]):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In\n\tregular editing mode this is right after the contents are saved back to the\n\tvalue parameter. This function is called everytime the viewer loses focus,\n\teven if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus\n\t\t\t\te.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp: textCOMP):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when\n\ttyping a character, deleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp: textCOMP, value: str, prevValue: str):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not\n\tcalled in 'Continuous Edit' mode. Use onTextEdit and onFocusEnd when using\n\tcontinuous editing.\n\n    Note: Any Python undo blocks created by this callback will be included in\n    the undo step for the change to the text field.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value,\n\t#      ', prev value: ', prevValue )\n\treturn\n"
    dat_content_format: text
- name: clock
  type: textCOMP
  parameters:
    text: =parent.Stage.ext.Stage.timeText() if parent.Stage.extensionsReady else ''
    callbacks: time_callbacks
    fontsize: 18
    fontcolorr: 0.86
    fontcolorg: 0.88
    fontcolorb: 0.9
    x: 258
    y: 12
    w: 150
    h: 48
    hmode: anchors
    leftanchor: 0.134375
    rightanchor: 0.2125
    vmode: anchors
    bottomanchor: 0.0111111
    topanchor: 0.0555556
  position: [600, 0]
  size: [160, 130]
  color: [0.67, 0.67, 0.67]
- name: StageExt
  type: textDAT
  parameters:
    file: project1/stage/StageExt.py
    syncfile: true
  position: [0, 2000]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: btn_play
  type: buttonCOMP
  parameters:
    label: =op.Lang.T('stage.play')
    value0: ~op.Transport.par.Play
    fontsize: 15
    colorr: =0.85 if me.par.value0 else 0.5
    colorg: =0.55 if me.par.value0 else 0.5
    colorb: =0.15 if me.par.value0 else 0.5
    x: 12
    y: 12
    w: 120
    h: 48
    leftanchor: 0.00625
    rightanchor: 0.06875
    bottomanchor: 0.0111111
    topanchor: 0.0555556
  position: [200, 0]
  children:
  - name: out1
    type: outCHOP
    position: [275, 175]
    inputs:
    - par1
  - name: par1
    type: parameterCHOP
    position: [65, 175]
  - name: text
    type: textCOMP
    parameters:
      text: =parent().par.label
      type: multiline
      legacyfontselection: true
      scaletofit: =parent().par[me.curPar.name] or me.curPar.val
      fontsize: =parent().par[me.curPar.name] or me.curPar.val
      linespacing: =parent().par[me.curPar.name] or me.curPar.val
      fontcolorr: =[c/.5 for c in [.1, .3]][parent().par.value0] * parent().par.colorr + .5
      fontcolorg: =[c/.5 for c in [.1, .3]][parent().par.value0] * parent().par.colorg + .5
      fontcolorb: =[c/.5 for c in [.1, .3]][parent().par.value0] * parent().par.colorb + .5
      textpaddingl: =parent().par[me.curPar.name] or me.curPar.val
      textpaddingr: =parent().par[me.curPar.name] or me.curPar.val
      textpaddingb: =parent().par[me.curPar.name] or me.curPar.val
      textpaddingt: =parent().par[me.curPar.name] or me.curPar.val
      hmode: fill
      vmode: fill
      clickthrough: true
      bgcolorr: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorr + r * 0.1
      bgcolorg: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorg + r * 0.1
      bgcolorb: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorb + r * 0.1
      bgalpha: 1
      borderar: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorr + .2
      borderag: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorg + .2
      borderab: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorb + .2
      leftborder: bordera
      rightborder: bordera
      bottomborder: bordera
      topborder: bordera
      borderover: false
    flags:
    - viewer
    position: [74, 26]
    size: [113, 96]
  - name: parexec1
    type: parameterexecuteDAT
    parameters:
      op: ..
      pars: value0
      onpulse: false
      defaultreadencoding: cp1252
      loadonstart: true
    flags:
    - viewer
    position: [66, -83]
    size: [128, 66]
    dat_content: "# par - the Par object that has changed\n# prev - the previous value\n\ndef onValueChange(par, prev):\n\tif not parent().panel.select :\n\t\tparent().panel.state = par.eval()\n\treturn"
    dat_content_format: text
  - name: panelexec1
    type: panelexecuteDAT
    parameters:
      panels: =parent()
      panelvalue: state
      offtoon: false
      valuechange: true
      defaultreadencoding: cp1252
      loadonstart: true
    flags:
    - viewer
    position: [247, -81]
    size: [126, 62]
    dat_content: "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue):\n\tparent().par.value0 = panelValue\n\treturn"
    dat_content_format: text
