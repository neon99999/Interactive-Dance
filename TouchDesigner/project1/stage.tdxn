    color: [0.67, 0.67, 0.67]
    dock: label
    dat_content: "# Text Component callbacks\n\nfrom typing import Any, Dict\n\ndef onValueChange(comp: textCOMP, value: str, prevValue: str):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason\n\tincluding typing in the text window or changing the parameter directly. The\n\tcallback is equivalent to the onValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value,\n\t#      ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp: textCOMP):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp: textCOMP, info: Dict[str, str]):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In\n\tregular editing mode this is right after the contents are saved back to the\n\tvalue parameter. This function is called everytime the viewer loses focus,\n\teven if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus\n\t\t\t\te.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp: textCOMP):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when\n\ttyping a character, deleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp: textCOMP, value: str, prevValue: str):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not\n\tcalled in 'Continuous Edit' mode. Use onTextEdit and onFocusEnd when using\n\tcontinuous editing.\n\n    Note: Any Python undo blocks created by this callback will be included in\n    the undo step for the change to the text field.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value,\n\t#      ', prev value: ', prevValue )\n\treturn\n"
    dat_content_format: text
- name: stage_pars
  type: parameterexecuteDAT
  parameters:
    op: =parent.Stage
    pars: Testtrack Testpattern Testdancer Open Close
    builtin: false
    file: project1/stage/stage_pars.py
    syncfile: true
  position: [200, 2000]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: tile_noise
  type: containerCOMP
  parameters:
    x: 288
    y: 252
    w: 288
    h: 180
    leftanchor: 0.15
    rightanchor: 0.3
    bottomanchor: 0.233333
    topanchor: 0.4
    bgcolorr: 0.075
    bgcolorg: 0.085
    bgcolorb: 0.1
    top: =parent.Stage.ext.Stage.tileTop('noise', tile=True) if parent.Stage.extensionsReady else None
    topfill: best
    borderag: 0.7
    borderab: 0.25
    borderbr: 0.035
    borderbg: 0.04
    borderbb: 0.05
    leftborderi: ='bordera' if parent.Stage.par.Mainview.eval() == 'noise' else 'borderb'
    rightborderi: ='bordera' if parent.Stage.par.Mainview.eval() == 'noise' else 'borderb'
    bottomborderi: ='bordera' if parent.Stage.par.Mainview.eval() == 'noise' else 'borderb'
    topborderi: ='bordera' if parent.Stage.par.Mainview.eval() == 'noise' else 'borderb'
  position: [600, 900]
  children:
  - name: 'on'
    type: buttonCOMP
    parameters:
      label: =op.Lang.T('stage.on' if me.par.value0 else 'stage.off')
      value0: ~op.Visuals.op('noise').par.Visible
      fontsize: 12
      colorr: =0.3 if me.par.value0 else 0.5
      colorg: =0.65 if me.par.value0 else 0.5
      colorb: =0.45 if me.par.value0 else 0.5
      x: 218
      y: 148
      w: 64
      h: 26
      leftanchor: 1
      leftoffset: -76
      rightoffset: -8
      bottomanchor: 1
      bottomoffset: -38
      topoffset: -8
    position: [400, 0]
    children:
    - name: out1
      type: outCHOP
      position: [275, 175]
      inputs:
      - par1
    - name: par1
      type: parameterCHOP
      position: [65, 175]
    - name: text
      type: textCOMP
      parameters:
        text: =parent().par.label
        type: multiline
        legacyfontselection: true
        scaletofit: =parent().par[me.curPar.name] or me.curPar.val
        fontsize: =parent().par[me.curPar.name] or me.curPar.val
        linespacing: =parent().par[me.curPar.name] or me.curPar.val
        fontcolorr: =[c/.5 for c in [.1, .3]][parent().par.value0] * parent().par.colorr + .5
        fontcolorg: =[c/.5 for c in [.1, .3]][parent().par.value0] * parent().par.colorg + .5
        fontcolorb: =[c/.5 for c in [.1, .3]][parent().par.value0] * parent().par.colorb + .5
        textpaddingl: =parent().par[me.curPar.name] or me.curPar.val
        textpaddingr: =parent().par[me.curPar.name] or me.curPar.val
        textpaddingb: =parent().par[me.curPar.name] or me.curPar.val
        textpaddingt: =parent().par[me.curPar.name] or me.curPar.val
        hmode: fill
        vmode: fill
        clickthrough: true
        bgcolorr: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorr + r * 0.1
        bgcolorg: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorg + r * 0.1
        bgcolorb: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorb + r * 0.1
        bgalpha: 1
        borderar: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorr + .2
        borderag: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorg + .2
        borderab: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorb + .2
        leftborder: bordera
        rightborder: bordera
        bottomborder: bordera
        topborder: bordera
        borderover: false
      flags:
      - viewer
      position: [74, 26]
      size: [113, 96]
    - name: parexec1
      type: parameterexecuteDAT
      parameters:
        op: ..
        pars: value0
        onpulse: false
        defaultreadencoding: cp1252
        loadonstart: true
      flags:
      - viewer
      position: [66, -83]
      size: [128, 66]
      dat_content: "# par - the Par object that has changed\n# prev - the previous value\n\ndef onValueChange(par, prev):\n\tif not parent().panel.select :\n\t\tparent().panel.state = par.eval()\n\treturn"
      dat_content_format: text
    - name: panelexec1
      type: panelexecuteDAT
      parameters:
        panels: =parent()
        panelvalue: state
        offtoon: false
        valuechange: true
        defaultreadencoding: cp1252
        loadonstart: true
      flags:
      - viewer
      position: [247, -81]
      size: [126, 62]
      dat_content: "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue):\n\tparent().par.value0 = panelValue\n\treturn"
      dat_content_format: text
  - name: label
    type: textCOMP
    parameters:
      text: =parent.Stage.ext.Stage.tileLabel('noise') if parent.Stage.extensionsReady else ''
      callbacks: label_callbacks
      fontsize: 14
      fontcolorr: =1.0 if parent.Stage.par.Mainview.eval() == 'noise' else 0.86
      fontcolorg: =0.7 if parent.Stage.par.Mainview.eval() == 'noise' else 0.88
      fontcolorb: =0.25 if parent.Stage.par.Mainview.eval() == 'noise' else 0.9
      textpaddingl: 10
      textpaddingr: 10
      alignx: left
      w: 288
      h: 28
      hmode: anchors
      bgalpha: 0.6
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  - name: label_callbacks
    type: textDAT
    flags:
    - viewer
    - -showDocked
    position: [0, -160]
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
    dock: label
    dat_content: "# Text Component callbacks\n\nfrom typing import Any, Dict\n\ndef onValueChange(comp: textCOMP, value: str, prevValue: str):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason\n\tincluding typing in the text window or changing the parameter directly. The\n\tcallback is equivalent to the onValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value,\n\t#      ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp: textCOMP):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp: textCOMP, info: Dict[str, str]):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In\n\tregular editing mode this is right after the contents are saved back to the\n\tvalue parameter. This function is called everytime the viewer loses focus,\n\teven if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus\n\t\t\t\te.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp: textCOMP):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when\n\ttyping a character, deleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp: textCOMP, value: str, prevValue: str):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not\n\tcalled in 'Continuous Edit' mode. Use onTextEdit and onFocusEnd when using\n\tcontinuous editing.\n\n    Note: Any Python undo blocks created by this callback will be included in\n    the undo step for the change to the text field.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value,\n\t#      ', prev value: ', prevValue )\n\treturn\n"
    dat_content_format: text
